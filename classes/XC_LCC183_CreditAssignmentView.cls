public without sharing class XC_LCC183_CreditAssignmentView {

    public class OiWrapper{
        public Decimal totalBundleAmount  {get;set;}
        public String bundleProdName {get;set;}
        public String incentiveItemName {get;set;}
        public String recordId {get;set;}
        public String creditAssignmentSurvey {get;set;}
        public Boolean creditAssignmentSurveyTaken {get;set;}
        public Boolean hasContract {get;set;}
        public Boolean hasAdditionalFieldsFilled {get;set;}
        //[BEGIN, arjun.raoh@accenture.com, NR2388, R2 2022, 10/02/2022]
        public String selectedIncentiveMode {get; set;}
        //[END, arjun.raoh@accenture.com, NR2388, R2 2022, 10/02/2022]
    }

    public class ResultWrapper{
        public String legalEntity;
        public String orderStatus;
        public String orderRt;
        public Boolean isInCommercialChange = false;
        public Boolean isCallOngoing = false;
        public String sessionId;
        public List<OiWrapper> ois = new List<OiWrapper>();
    }


    /**
    * @description return the serialized wrapper list for orderItems
    * @author Francesco Imperioli - fimperioli@deloitte.it | 7/4/2020 
    * @param orderId 
    * @return String 
    **/
    @AuraEnabled
    public static String getIncentiveItems(String orderId){
        
        ResultWrapper rw = new ResultWrapper();
        List<OiWrapper> resultOis = new List<OiWrapper>();
        Set<String> oisIds = new Set<String>();

        NE__Order__c currentOrder = [SELECT Id,XC_LegalEntity__c,XC_Status__c,RecordTypeAUX__c,XC_CommercialChange__c,XC_TechnicalProductOnly__c FROM NE__Order__c WHERE ID=:orderId LIMIT 1];

        //check if there's an ongoing CTI call, no credit assignment during the calls
        Boolean isCallOngoing = [SELECT Id,XC_InteractionStatus__c,CreatedById FROM XC_CTI_Interaction__c WHERE XC_InteractionStatus__c = 'Open' AND CreatedById = :UserInfo.getUserId() LIMIT 1].size()>0;

        List<NE__OrderItem__c> ois = [SELECT Id,NE__OrderId__r.XC_LegalEntity__c,
        NE__ProdName__c,NE__Bundle_Configuration__r.NE__ProdName__c,
        NE__Bundle_Configuration__r.XC_CongaDynamicAPI__c,NE__Bundle_Configuration__r.XC_BundleTotalOTAmount__c,
        XC_CreditAssignmentSurvey__c,XC_CreditAssignmentAvailable__c,XC_CityCode__c,
        XC_UrbanSection__c,XC_Subordinate__c,XC_HouseType__c,XC_Particle__c,XC_Sheet__c, 
        XC_SelectedIncentiveMode__c //arjun.raoh@accenture.com, NR2388, R2 2022, 10/02/2022
        FROM NE__OrderItem__c 
        WHERE 
        NE__OrderId__c = :orderId AND 
        XC_Product_Subtype__c = :Label.XC_CL_ProductSubtypeIncentive AND
        NE__Bundle_Configuration__c != null AND
        XC_CreditAssignmentSurvey__c != null
        ];

        for(NE__OrderItem__c oi : ois){
            oisIds.add(oi.Id);
        }

        //getting eventual survey responses to check if survey has been already taken on single orderItems
        List<XC_GetFeedbackResponse__c> surveyResponses = [SELECT Id,XC_ConfigurationItem__c FROM XC_GetFeedbackResponse__c WHERE XC_ConfigurationItem__c IN : oisIds];
        Map<String,XC_GetFeedbackResponse__c> oiFeedbackMap = new Map<String,XC_GetFeedbackResponse__c>();

        for(XC_GetFeedbackResponse__c gfr : surveyResponses){
            oiFeedbackMap.put(gfr.XC_ConfigurationItem__c,gfr);
        }

        Boolean hasContract = false;
        for(NE__OrderItem__c oi : ois){
            OiWrapper wrap = new OiWrapper();
            wrap.bundleProdName = oi.NE__Bundle_Configuration__r.NE__ProdName__c;
            wrap.recordId = oi.Id;
            wrap.totalBundleAmount = oi.NE__Bundle_Configuration__r.XC_BundleTotalOTAmount__c;
            wrap.incentiveItemName = oi.NE__ProdName__c;
            wrap.creditAssignmentSurvey = oi.XC_CreditAssignmentSurvey__c;
            wrap.creditAssignmentSurveyTaken = oiFeedbackMap.containsKey(oi.Id);
            //check if for this incentive a contract has been already generated by conga
            wrap.hasContract = String.isNotBlank(oi.NE__Bundle_Configuration__r.XC_CongaDynamicAPI__c);
            wrap.hasAdditionalFieldsFilled = checkAdditionalFields(oi);
            //[BEGIN, arjun.raoh@accenture.com, NR2388, R2 2022, 10/02/2022]
            wrap.selectedIncentiveMode = oi.XC_SelectedIncentiveMode__c;
            //[BEGIN, arjun.raoh@accenture.com, NR2388, R2 2022, 10/02/2022]
            resultOis.add(wrap);
        }

        rw.legalEntity = currentOrder.XC_LegalEntity__c;
        rw.orderStatus = currentOrder.XC_Status__c;
        rw.orderRt = currentOrder.RecordTypeAUX__c;
        rw.isCallOngoing = isCallOngoing;
        rw.isInCommercialChange = !currentOrder.XC_TechnicalProductOnly__c;
        rw.sessionId = UserInfo.getSessionId();
        rw.ois.addAll(resultOis);

        return JSON.serialize(rw);

    }

    /**
    * @description Check if additional fields mandatory for credit assignment have been filled correctly.
    * @author Francesco Imperioli - fimperioli@deloitte.it | 25/5/2020 
    * @param incentiveItem 
    * @return Boolean 
    **/
    private static Boolean checkAdditionalFields(NE__OrderItem__c incentiveItem){
        return String.isNotBlank(incentiveItem.XC_CityCode__c) && 
        String.isNotBlank(incentiveItem.XC_Subordinate__c) &&
        String.isNotBlank(incentiveItem.XC_HouseType__c) &&
        String.isNotBlank(incentiveItem.XC_Particle__c) &&
        String.isNotBlank(incentiveItem.XC_Sheet__c);
    }

    /**
    * @description propagate additional infos to other incentive items inside the order
    * @author Francesco Imperioli - fimperioli@deloitte.it | 11-17-2020 
    * @param paramsMap 
    * @return Boolean 
    **/
    @AuraEnabled
    public static Boolean propagateAdditionalInfos (Map<String,Object> paramsMap){


        String orderId = String.valueOf(paramsMap.get('orderId'));
        String cityCode = String.valueOf(paramsMap.get('cityCode'));
        String subordinate = String.valueOf(paramsMap.get('subordinate'));
        String houseType = String.valueOf(paramsMap.get('houseType'));
        String urbanSection = String.valueOf(paramsMap.get('urbanSection'));
        String sheet = String.valueOf(paramsMap.get('sheet'));
        String particle = String.valueOf(paramsMap.get('particle'));
        String updatedItemId = String.valueOf(paramsMap.get('updatedItemId'));


        List<NE__OrderItem__c> ois = [SELECT Id,NE__OrderId__r.XC_LegalEntity__c,
        NE__ProdName__c,NE__Bundle_Configuration__r.NE__ProdName__c,
        NE__Bundle_Configuration__r.XC_CongaDynamicAPI__c,
        XC_CreditAssignmentSurvey__c,XC_CreditAssignmentAvailable__c,XC_CityCode__c,
        XC_UrbanSection__c,XC_Subordinate__c,XC_HouseType__c,XC_Particle__c,XC_Sheet__c
        FROM NE__OrderItem__c 
        WHERE 
        NE__OrderId__c = :orderId AND 
        XC_Product_Subtype__c = :Label.XC_CL_ProductSubtypeIncentive AND
        NE__Bundle_Configuration__c != null AND
        XC_CreditAssignmentSurvey__c != null AND Id != :updatedItemId
        ];

        for(NE__OrderItem__c incentive : ois){
            incentive.XC_CityCode__c = cityCode;
            incentive.XC_UrbanSection__c = urbanSection;
            incentive.XC_Subordinate__c = subordinate;
            incentive.XC_HouseType__c = houseType;
            incentive.XC_Sheet__c = sheet;
            incentive.XC_Particle__c = particle;
        }

        return XC_UTIL_Sobject.checkDMLResults(XC_UTIL_Sobject.updateListRecords(ois));

    } 

}