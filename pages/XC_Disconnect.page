<apex:page standardcontroller="Asset"  showHeader="false" sidebar="false">
    
    <script src="/soap/ajax/25.0/connection.js" type="text/javascript"></script>
    <script src="/soap/ajax/10.0/apex.js" type="text/javascript"></script>
    
    
    <script>
    sforce.connection.sessionId = '{!JSENCODE($Api.Session_ID)}';

    var id='{!JSENCODE(Asset.Id)}'; 
    var status='{!JSENCODE(Asset.NE__Status__c)}';
    var rootitem = '{!JSENCODE(Asset.NE__Root_Order_Item__c)}';
    
    if(status=='In Progress' || (rootitem!=null && rootitem!='')||status=='Disconnected') 
    { 
        alert('{!$Label.ne__no_asset_op}'); 
    } 
    else
    { 
        
        var d = new Date(); 
        
        var sMessage = sforce.apex.execute("NE.JS_RemoteMethods","verifyAssetPenalties", {assetId:id, deactivationDate:d}); 
        
        if(sMessage != '')
        { 
            var r = confirm(sMessage);
        }
        else
        {
            var r = confirm("{!$Label.ne__start_disconnection_asset_confirm}"); 
        } 
        
        if (r == true)
        { 
            var Idorder = sforce.apex.execute("NE.JS_RemoteMethods","stdasset2order",{idasset:id,Type:"Disconnect"}); 
            console.log("Id order generated: "+Idorder);
            if((Idorder !=null)&&(Idorder !='')) 
            {
                if( (typeof sforce != 'undefined') && (sforce != null) && Idorder.length > 0)
                {
                    console.log("Idorder from lightning: "+Idorder[0]);
                    //sforce.one.navigateToSObject(Idorder);
                    sforce.one.navigateToSObject(Idorder[0],"detail");
                }
                else
                    top.window.location.href='{!$Site.Prefix}'+'/'+Idorder[0];                   
            }
        }
    }
    </script>
</apex:page>