<aura:component controller ="XC_LCC198_ReLaunchProvisioningStep" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    
    <aura:attribute name="spinnerControl" type="Boolean" default="false"/>
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="record" type="Object" />
    <aura:attribute name="componentRecord" type="Object" />
    <aura:attribute name="recordError" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.init}" />

    <force:recordData 
        aura:id="recordLoader" 
        recordId="{!v.recordId}" 
        fields="XC_Configuration_Item__c, XC_ConfigurationId__c, XC_Country__c, XC_Flow_API_Name__c, XC_Mandatory_Steps__c, XC_ProdId__c, XC_Status__c, XC_StepLabel__c, XC_Step_Code__c, XC_Step_Order__c, XC_Synchronous__c, XC_Template_Name__c, XC_ErrorMessage__c, XC_MasterOfSubscription__c, XC_ToBeAutocompleted__c, XC_ZuoraSubscriptionId__c, XC_MasterofProductReservation__c"
        layoutType="FULL" 
        mode="EDIT"
        targetRecord="{!v.record}"
        targetFields="{!v.componentRecord}"
        targetError="{!v.recordError}" />   
    
    <aura:if isTrue="{!v.spinnerControl}" >
        <div aura:id="masterSpinner" style="position: fixed; top: 0; right: -532px; bottom: 0; left: -532px; z-index: 9998; background-color: white">
            <lightning:spinner aura:id="mySpinner"/>
        </div>
    </aura:if>
    
</aura:component>