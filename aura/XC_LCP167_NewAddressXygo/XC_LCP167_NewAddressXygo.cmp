<!--
* @author Lorenzo Orlanducci - lorenzo.orlanducci@nttdata.it 
* @date Creation 03/04/2019
* @date Modification 22/10/2019 Simone Trenta - strenta@deloitte.it
* @description XC_LCC167_NewAddressXygo – Component for create new Address
-->
<aura:component controller="XC_LCC167_NewAddressXygo"
    implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,lightning:actionOverride,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,lightning:actionOverride">

    <aura:attribute name="recordId" type="String" />
    <!--<aura:attribute name="addressId" type="String" />-->
    <aura:attribute name="leadId" type="String" />
    <aura:attribute name="accountId" type="String" />
    <aura:attribute name="source" type="String" default="" />
    <aura:attribute name="IdFromMobile" type="String" />
    <aura:attribute name="podValue" type="String" />
    <aura:attribute name="showCheckbox" type="Boolean" default="false" />
    <aura:attribute name="showButtonSection" type="Boolean" default="true" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />
    <aura:attribute name="showSecondPick" type="Boolean" default="true" />
    <aura:attribute name="fromComponent" type="Boolean" default="false" />
    <aura:attribute name="show3Pick" type="Boolean" default="true" />
    <aura:attribute name="from52" type="Boolean" default="false" />
    <aura:attribute name="from102" type="Boolean" default="false" />
    <aura:attribute name="showStrikeModal" type="Boolean" default="false" />
    <aura:attribute name="showMunicipality" type="Boolean" default="false" />
    <aura:attribute name="title" type="String" />
    <aura:attribute name="disabled" type="Boolean" default="false" />
    <aura:attribute name="showToastMessage" type="boolean" default="false" />
    <aura:attribute name="successMessage" type="String" default="" />
    <aura:attribute name="requiredAttribute" type="List"
        default="city,address,streetNumber,province,municipality,country,postalCode" />

    <!-- After AutoComplete -->
    <aura:attribute name="searchresultStreet" type="List" default="[]" />
    <aura:attribute name="searchresultCity" type="List" default="[]" />
    <aura:attribute name="searchresultZip" type="List" default="[]" />
    <aura:attribute name="returnedZipList" type="Boolean" default="false" />
    <aura:attribute name="autocomplete" type="Boolean" default="true" />
    <aura:attribute name="timer" type="Object" default="null" />
    <aura:attribute name="showAddressSugg" type="Boolean" default="false" />
    <aura:attribute name="showCitySugg" type="Boolean" default="false" />
    <aura:attribute name="showZipSugg" type="Boolean" default="false" />
    <aura:attribute name="showPods" type="Boolean" default="false" />
    <aura:attribute name="requestTimeOut" type="Integer" default="1000" />
    <aura:attribute name="addressToUpdate" type="Boolean" default="false" />
    <aura:attribute name="skipValChecked" type="Boolean" default="false" />
    <aura:attribute name="showSave" type="Boolean" default="true" />
    <aura:attribute name="selectedCup" type="String" />
    <aura:attribute name="searchresultCup" type="List" default="[]" />

    <aura:attribute name="address" type="Map" default=" {
            country : '',
            streetType : '',
            address : '',
            streetNumber : '',
            door : '',
            postalCode : '',
            stair : '',
            floor : '',
            city : '',
            province : '',
            category : '',
            municipality : '',
            provinceCode : '',
            cityCode : '',
            streetTypeText : '',
            gas : '',
            electric : '',
            lead: '',
            account: '', 

            validate : false,
            validatedCups : false,
            isAccountPartner : 'false',

            clarifType : '',
            clarifValue : ''
            }" />

    <lightning:workspaceAPI aura:id="workspace" />
    <aura:registerEvent name="XC_LCE013_SetAddressObject" type="c:XC_LCE013_SetAddressObject" />
    <aura:registerEvent name="XC_LCE004_closeNewAddress" type="c:XC_LCE004_closeNewAddress" />
    <aura:registerEvent name="XC_LCE018_ChangeAddressCountry" type="c:XC_LCE018_ChangeAddressCountry" />
    <aura:handler name="init" value="{! this }" action="{! c.doInit }" />
    <aura:handler name="strike_evt_modalPrimaryButtonClicked" event="c:strike_evt"
        action="{!c.handlePrimaryButtonClick}" />
    <aura:handler name="strike_evt_modalSecondaryButtonClicked" event="c:strike_evt"
        action="{!c.handleSecondaryButtonClick}" />

    <ltng:require styles="{!$Resource.XC_STR004_CompWidth100}" />
    <lightning:notificationsLibrary aura:id="notifLib" />

    <div class="c-container" style="background-color:white !important; border-radius: 4px;">

        <article class="slds-card">
            <div class="slds-card__header slds-grid">
                <aura:if isTrue="{!and((v.source!='002'), (v.source!='003'))}">
                    <header class="slds-media slds-media_center slds-has-flexi-truncate">
                        <lightning:icon class="slds-icon slds-icon-standard-email-iq" iconName="standard:email"
                            alternativeText="{!$Label.c.XC_CL_Address}" />
                        <div class="slds-assistive-text">&nbsp; {!$Label.c.XC_CL_Address}</div>
                        <div class="slds-media__body">
                            <h2 class="slds-card__header-title">
                                <div class="slds-text-heading_small">&nbsp; <b>Address</b></div>
                            </h2>
                        </div>
                    </header>
                </aura:if>
            </div>


            <div style="margin:10px;">
                <lightning:recordEditForm objectApiName="XC_Address__c">

                    <lightning:messages />

                    <lightning:layout multipleRows="true">
                        <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6"
                            padding="around-small">

                            <aura:if isTrue="{!v.showSecondPick}">
                                <lightning:inputField aura:id="country" fieldName="XC_AddressCountry__c"
                                    disabled="false" onchange="{!c.setPickCountry}" value="{!v.address.country}" />
                            </aura:if>

                            <div style="position:relative;">
                                <lightning:inputField aura:id="city" fieldName="XC_City__c" value="{!v.address.city }"
                                    disabled="true" onchange="{!c.typingCity}" onclick="{!c.checkCity}"
                                    variant="label-inline" />
                                <aura:if isTrue="{!v.showCitySugg}">
                                    <div id="listbox-suggestions" aura:id="query-suggest-box-city"
                                        class="slds-dropdown_length-10" role="listbox">
                                        <ul aura:id="query-suggest-list"
                                            class="slds-listbox slds-listbox_vertical slds-textarea"
                                            role="presentation">
                                            <aura:iteration items="{!v.searchresultCity}" var="sugg" indexVar="index">
                                                <li aura:id="query-suggest-item" role="presentation"
                                                    class="slds-listbox__item">
                                                    <div aura:id="query-suggestions" id="{!sugg.value}"
                                                        class="slds-media slds-listbox__option slds-listbox__option_plain slds-media_small"
                                                        role="option" value="{!sugg}" onclick="{!c.selectCity}">
                                                        {!sugg.label}
                                                    </div>
                                                </li>
                                            </aura:iteration>
                                        </ul>
                                    </div>
                                </aura:if>
                            </div>

                            <aura:if isTrue="false">
                                <lightning:inputField aura:id="streetType" fieldName="XC_StreetTypeText__c"
                                    onchange="{!c.setPickStreetType }" disabled="true"
                                    value="{!v.address.streetTypeText}" />
                            </aura:if>


                            <div style="position:relative;">
                                <lightning:inputField aura:id="address" fieldName="XC_Address__c"
                                    value="{!v.address.address }" disabled="true" onchange="{!c.typingAddress}"
                                    onclick="{!c.checkAddress}" />
                                <aura:if isTrue="{!v.showAddressSugg}">
                                    <div id="listbox-suggestions" aura:id="query-suggest-box-address"
                                        class="slds-dropdown_length-10" role="listbox">
                                        <ul aura:id="query-suggest-list"
                                            class="slds-listbox slds-listbox_vertical slds-textarea"
                                            role="presentation">
                                            <aura:iteration items="{!v.searchresultStreet}" var="sugg" indexVar="index">
                                                <li aura:id="query-suggest-item" role="presentation"
                                                    class="slds-listbox__item">
                                                    <div aura:id="query-suggestions" id="{!sugg.value}"
                                                        class="slds-media slds-listbox__option slds-listbox__option_plain slds-media_small"
                                                        role="option" value="{!sugg}" onclick="{!c.selectAddress}">
                                                        {!sugg.label}
                                                    </div>
                                                </li>
                                            </aura:iteration>
                                        </ul>
                                    </div>
                                </aura:if>
                            </div>

                            <aura:renderIf isTrue="{!v.address.country != 'Colombia'}">
                                <lightning:inputField aura:id="streetNumber" fieldName="XC_StreetNumber__c"
                                    value="{!v.address.streetNumber }" disabled="true" />
                            </aura:renderIf>

                            <div style="position:relative;">
                                <lightning:inputField aura:id="postalCode" value="{!v.address.postalCode}"
                                                      fieldName="XC_PostalCode__c" disabled="true" onchange="{!c.typingZip}"
                                                      onclick="{!c.checkZip}" />
                                <aura:if isTrue="{!v.showZipSugg}">
                                    <div id="listbox-suggestions" aura:id="query-suggest-box-zip"
                                         class="slds-dropdown_length-10" role="listbox">
                                        <ul aura:id="query-suggest-list"
                                            class="slds-listbox slds-listbox_vertical slds-textarea"
                                            role="presentation">
                                            <aura:iteration items="{!v.searchresultZip}" var="sugg"
                                                            indexVar="index">
                                                <li aura:id="query-suggest-item" role="presentation"
                                                    class="slds-listbox__item">
                                                    <div aura:id="query-suggestions" id="{!sugg.value}"
                                                         class="slds-media slds-listbox__option slds-listbox__option_plain slds-media_small"
                                                         role="option" value="{!sugg}" onclick="{!c.selectZip}">
                                                            {!sugg.label}
                                                        </div>
                                                </li>
                                            </aura:iteration>
                                        </ul>
                                    </div>
                                </aura:if>
                            </div>
                        </lightning:layoutItem>

                        <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6"
                            padding="around-small">


                            <aura:if isTrue="{!v.showSecondPick}">
                                <aura:if isTrue="{!v.show3Pick}">
                                    <aura:if isTrue="{!v.address.country == 'Spain'}">
                                        <lightning:inputField aura:id="province" fieldName="XC_AddressProvince__c"
                                            onchange="{!c.setPickProvince }" disabled="true"
                                            value="{!v.address.province}" />
                                        <aura:set attribute="else">
                                            <lightning:inputField aura:id="provinceText" name="provinceText"
                                                fieldName="XC_Region__c" onchange="{!c.setPickProvince }"
                                                disabled="true" value="{!v.address.province}" />
                                        </aura:set>
                                    </aura:if>

                                </aura:if>
                            </aura:if>






                            <!-- <aura:if isTrue="{!v.showMunicipality}"> -->
                            <lightning:inputField aura:id="municipality" fieldName="XC_Municipality__c"
                                value="{!v.address.municipality}" disabled="true" />
                            <!--  </aura:if> -->

                            <lightning:inputField aura:id="clarifType" fieldName="XC_ClarificatorType__c"
                                value="{!v.address.clarifType }" disabled="true" size="6" />

                            <lightning:inputField aura:id="clarifValue" fieldName="XC_ClarificatorValue__c"
                                value="{!v.address.clarifValue }" disabled="true" size="6" />
                            <lightning:inputField aura:id="electric" fieldName="XC_ElectricCUPS__c"
                                value="{!v.address.electric }" disabled="true" size="6" />

                        </lightning:layoutItem>

                    </lightning:layout>

                </lightning:recordEditForm>

                <aura:if isTrue="{!v.showSpinner}">
                    <lightning:spinner alternativeText="Loading" size="large"
                        style="background-color: rgba(0, 0, 0, 0)" />
                </aura:if>

                <aura:if isTrue="{!and(v.address.validate,not(v.showCheckbox))}">
                    <lightning:input type="checkbox" label="{!$Label.c.XC_CL_Address_AddressValidated}" checked="{!v.address.validate}"
                        disabled="true" />
                    <br></br>
                </aura:if>

                <br></br>

                <aura:if isTrue="{!v.showCheckbox}">
                    <lightning:input aura:id="skipVal" type="checkbox" label="{!$Label.c.XC_CL_SaveWithoutValidate}"
                        onchange="{!c.skipValidation}" />
                </aura:if>


                <lightning:layout horizontalAlign="end">
                    <lightning:layoutItem padding="around-small">

                        <lightning:buttonGroup>
                            <aura:if isTrue="{!!v.disabled}">

                                <aura:if isTrue="{!and((v.source!='002'), (v.source!='003'))}">
                                    <aura:if isTrue="{!or(v.showSave)}">
                                        <lightning:button aura:id="saveButton" disabled="{!!v.address.validate}"
                                            variant="brand" label="{!$Label.c.XC_CL_SaveButton}" title="Brand action"
                                            onclick="{!c.saveAddress}" />
                                    </aura:if>
                                </aura:if>

                                <aura:if isTrue="{!v.showButtonSection}">
                                    <aura:if isTrue="{!!v.skipValChecked}">
                                        <lightning:button label="{!$Label.c.XC_CL_Address_Validate}"
                                            onclick="{!c.onValidate}" />
                                    </aura:if>
                                </aura:if>

                                <aura:if isTrue="{!not(v.showButtonSection)}">
                                    <lightning:button label="{!$Label.c.XC_CL_EditButton}" onclick="{!c.onModify}" />
                                </aura:if>

                            </aura:if>

                            <aura:if isTrue="{!and((v.source!='002'), (v.source!='003'))}">
                                <aura:if isTrue="{!!v.addressToUpdate}">
                                    <lightning:button label="{!$Label.c.XC_CL_Cancel}" title="Brand action"
                                        onclick="{! c.cancel }" />
                                </aura:if>
                            </aura:if>

                        </lightning:buttonGroup>

                    </lightning:layoutItem>
                </lightning:layout>
            </div>
        </article>
    </div>
</aura:component>