<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,lightning:actionOverride,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,force:hasSObjectName" access="global">
   
    
    <aura:attribute name="completeURL" type="String" /> 
    <aura:handler name="init" value="{!this}" action="{!c.createURL}" /> 
    <ltng:require styles="{!$Resource.XC_STR004_CompWidth100}" /> 
    <div class="c-container">
    	<iframe src="{!v.completeURL}" width="100%" height="500px" frameBorder="0" />
    </div>
</aura:component>