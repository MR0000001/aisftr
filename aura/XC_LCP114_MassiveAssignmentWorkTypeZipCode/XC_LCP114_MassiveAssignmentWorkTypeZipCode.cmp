<!--
* @author Salvatore Agrillo - salvatore.agrillo@nttdata.com
* @date Creation 13/09/2019
* @description XC_LCP114_MassiveAssignmentWorkTypeZipCode – Component for Massive WorkType/ZipCode Assignment
-->

<aura:component controller="XC_LCC114_MassWorktypeZipcode"
                implements="force:appHostable,force:lightningQuickActionWithoutHeader,force:hasRecordId" access="global">

    <lightning:overlayLibrary aura:id="overlayLib" />

    <aura:attribute name="partnerChoosed" type="Boolean" default="false"/>
    <aura:attribute name="originPartner" type="String" default=""/>
    <aura:attribute name="spinnerControl" type="Boolean" default="false"/>
    <aura:attribute name="spinnerControlLoadWorkType" type="Boolean" default="false"/>
    <aura:attribute name="preferredOperation" type="String" default=""/>
    <aura:attribute name="destinationPartner" type="String" default=""/>
    <aura:attribute name="filterStrikeLookupDestination" type="String"/>
    <aura:attribute name="selectedRowsCountWorktype" type="Integer" default="0"/>
    <aura:attribute name="dataWorktype" type="List"/>
    <aura:attribute name="columnsWorktype" type="List"/> 
    <aura:attribute name="columnsZipCodeAdd" type="List"/>
    <aura:attribute name="selectedRowsCountProvince" type="Integer" default="0"/>
    <aura:attribute name="selectedRowsCountZipcode" type="Integer" default="0"/>
    <aura:attribute name="selectedRowsCountZipcodeForAdd" type="Integer" default="0"/>
    <aura:attribute name="columnsZipcode" type="List"/>
    <aura:attribute name="columnsProvince" type="List"/>
    <aura:attribute name="dataZipcode" type="List"/> 
    <aura:attribute name="dataZipcodeAdd" type="List"/>
    <aura:attribute name="dataAddZipcode" type="List"/>
    <aura:attribute name="displayRowAdd" type="List"/>
    <aura:attribute name="displayRowRemTransf" type="List"/>
    <aura:attribute name="isOperation" type="Boolean" default="false"/> 
    <aura:attribute name="readyButton" type="Boolean" default="false"/>    
    <aura:attribute name="textButton" type="String" default=""/>     
    <aura:attribute name="isOptionSelected" type="Boolean" default="false"/>   
    <aura:attribute name="isDestinationPartner" type="Boolean" default="false"/> 
    <aura:attribute name="disableButton" type="Boolean" default="false"/>
    <aura:attribute name="dataProvinces" type="List"/>
    <aura:attribute name="originalDataProvince" type="List"/>
    <aura:attribute name="originalAddZippCode" type="List"/>
    <aura:attribute name="originalDataWorktype" type="List"/>
    <aura:attribute name="country" type="String" default=""/>
    <aura:attribute name="originalDataZipcode" type="List"/>
    <aura:attribute name="tempDataZipcode" type="List"/>
    <aura:attribute name="selectedRowsWorktype" type="List"/>
    <aura:attribute name="selectedRowsProvince" type="List"/>
    <aura:attribute name="selectedRowsZipCodeAdd" type="List"/>
    <aura:attribute name="selectedRowsZipcode" type="List"/>
    <aura:attribute name="optionSelected" type="String" default=""/>
    <aura:attribute name="disableAdd" type="Boolean" default="true"/>
    <aura:attribute name="disableRemove" type="Boolean" default="true"/>
    <aura:attribute name="disableTransfer" type="Boolean" default="true"/>
    <aura:attribute name="isFiltered" type="Boolean" default="false"/>
    <aura:attribute name="isWorktypeSelectedForAdd" type="Boolean" default="false"/>
    <aura:attribute name="isSelectedProvince" type="Boolean" default="false"/>
    <aura:attribute name="titleZipcodeTable" type="String" default=""/>
    <aura:attribute name="filterWorktype" type="String" default=""/>
    <aura:attribute name="filterZipCode" type="String" default=""/>
    <aura:attribute name="filterZipCodeAdd" type="String" default=""/>
    <aura:attribute name="filterProvince" type="String" default=""/>
    <aura:attribute name="displayWorktype" type="List"/> 
    <aura:attribute name="displayZipcodeAdd" type="List"/> 
    <aura:attribute name="displayZipCode" type="List"/>
    <aura:attribute name="displayProvince" type="List"/>
    <aura:attribute name="listIdSelectedPrecWorktype" type="List"/>
    <aura:attribute name="listIdSelectedPrecZipcode" type="List"/>
    <aura:attribute name="listIdSelectedPrecProvince" type="List"/>
    <aura:attribute name="listIdSelectedPrecZipcodeAdd" type="List"/>
    <aura:attribute name="isChangeFilterZipcodeAdd" type="Boolean" default="false"/>
    <aura:attribute name="isChangeFilterProvince" type="Boolean" default="false"/>
    <aura:attribute name="isChangeFilterWorktype" type="Boolean" default="false"/>
    <aura:attribute name="isChangeFilterZipcode" type="Boolean" default="false"/>
    <aura:attribute name="disabledPickList" type="Boolean" default="false"/>
    <aura:attribute name="nameResourceZipCode" type="String"/>

    <lightning:navigation aura:id="navService"/>
    <lightning:workspaceAPI aura:id="workspace" />


    <aura:handler name="change" value="{!v.originPartner}" action="{!c.init}" />
    <aura:handler name="change" value="{!v.destinationPartner}" action="{!c.enableButton}" />
    <aura:handler name="change" value="{!v.preferredOperation}" action="{!c.onChangePicklist}" />
    <aura:handler name="change" value="{!v.destinationPartner}" action="{!c.onSelectedDestinationPartner}" />

    <!-- To choose Partner -->
    <div class="cardOriginPartner" style="margin-bottom:7px">
        <lightning:card title="{!$Label.c.XC_CL_MassAssSkillTitleOriginPartner}" iconName="utility:change_owner">
            <lightning:layout verticalAlign="left" horizontalAlign="left">
                <lightning:layoutItem padding="around-small" flexibility="auto" size="5">
                    <c:strike_lookup
                        label="{!$Label.c.XC_CL_MassAssSkillLabelOrigin}"
                        object="Account"
                        searchField="Name"
                        placeholder="{!$Label.c.XC_CL_MassAssSkillHolderOrigin}"
                        iconName="standard:account"
                        order="Name"
                        limit="5"
                        loadingMessage="{!$Label.c.XC_CL_MassAssSkillLoadingOrigin}"
                        errorMessage="{!$Label.c.XC_CL_MassAssSkillErrorOrigin}"
                        showRecentRecords="true"
                        value = "{!v.originPartner}"
                        required="true"
                        filter="RecordType.Name = 'Partner' AND Name != 'No Candidate Found'"/>
                </lightning:layoutItem>
            </lightning:layout>
        </lightning:card>
    </div>

    <!-- To choose Operation -->
    <aura:if isTrue="{!v.partnerChoosed}">
        <div class="cardPreferredOperation" style="margin-bottom:7px">
            <lightning:card title="{!$Label.c.XC_CL_MassAssSkillTitlePartner}" iconName="utility:settings">
                <lightning:layout verticalAlign="left" horizontalAlign="left">
                    <lightning:layoutItem padding="around-small" flexibility="auto" size="5">
                        <c:strike_picklist 
                            value="{!v.preferredOperation}"
                            label="{!$Label.c.XC_CL_MassAssSkillSelectOperation}"
                            placeholder="{!$Label.c.XC_CL_MassAssSkillHolderOperation}"
                            errorMessage="{!$Label.c.XC_CL_MassAssSkillErrorOperation}"
                            required="true"
                            disabled="{!v.disabledPickList}">
                            <c:strike_optionGroup label="{!$Label.c.XC_CL_MassAssSkillOpExistingSkill}">
                                <c:strike_option label="{!$Label.c.XC_CL_MassAssSkillOpAdd}" value="Add" iconName="utility:add"/>
                                <c:strike_option label="{!$Label.c.XC_CL_MassAssSkillOpRemove}" value="Remove" iconName="utility:close"/>
                            </c:strike_optionGroup>
                            <c:strike_optionGroup label="{!$Label.c.XC_CL_MassAssSkillOpTransferSkill}">
                                <c:strike_option label="{!$Label.c.XC_CL_MassAssSkillOpTransfer}" value="Transfer" iconName="utility:contract_alt"/>
                            </c:strike_optionGroup>
                        </c:strike_picklist>
                    </lightning:layoutItem>
                </lightning:layout>
            </lightning:card>
        </div>

        <!-- For Remove and Transfer: -->
        <aura:if isTrue="{!v.isOptionSelected}">
            <div class="cardFilters" style="margin-bottom:7px">  
                <lightning:card title="{!$Label.c.XC_CL_MassAssSkillChooseFilter}" iconName="utility:center_align_text">
                    <lightning:layout verticalAlign="center" horizontalAlign="center">
                            
                        <lightning:layoutItem padding="around-small" flexibility="auto">
                            <lightning:input 
                                type="text"
                                name="searchWorktype"
                                label="{!$Label.c.XC_CL_MassAssSkill_FilterSkill}"
                                onchange="{!c.onChangeFilterWorktype}"
                                variant="label-hidden"
                                value="{!v.filterWorktype}"
                                placeholder="{!$Label.c.XC_CL_MassAssSkill_FilterSkill}"
                            />
                            <div style="margin-bottom:20px;height: 300px; width: 300px">
                                <h1 style="text-align:center;"><b>{!$Label.c.XC_CL_MassAssSkill_SkillPartner}</b></h1>
                                <h1 style="text-align:center;">{!$Label.c.XC_CL_MassAssSkill_SelectedRow}: {!v.selectedRowsCountSkill}</h1>
                                <lightning:datatable
                                    title="{!$Label.c.XC_CL_MassAssSkillTableSkill}"
                                    columns="{!v.columnsWorktype}"
                                    data="{!v.dataWorktype}" 
                                    aura:id="tableWorktypeForAdd" 
                                    keyField="Id"
                                    selectedRows="{!v.displayWorktype}"
                                    onrowselection="{!c.onChangeTableWorktype}"/>
                            </div>
                        </lightning:layoutItem>
                        
                        <aura:if isTrue="{!v.isFiltered}">
                            <lightning:layoutItem padding="around-small" flexibility="auto">
                                <lightning:input 
                                    type="text"
                                    name="searchZipCode"
                                    label="{!$Label.c.XC_CL_MassAssSkill_FilterZipCode}"
                                    value="{!v.filterZipCode}"
                                    onchange="{!c.onChangeFilterZipCode}"
                                    variant="label-hidden"
                                    placeholder="{!$Label.c.XC_CL_MassAssSkill_FilterZipCode}"
                                />
                                <div style="margin-bottom:20px;height: 300px; width: 800px">
                                    <h1 style="text-align:center;"><b>{!v.titleZipcodeTable}</b></h1>
                                    <h1 style="text-align:center;">{!$Label.c.XC_CL_MassAssSkill_SelectedRow}: {!v.selectedRowsCountZipcode}</h1>
                                    <lightning:datatable
                                        title="{!v.titleZipcodeTable}"
                                        columns="{!v.columnsZipcode}"
                                        data="{!v.dataZipcode}"
                                        onrowselection="{!c.onChangeTableZipCode}"
                                        aura:id="tableZipCode" 
                                        keyField="Id"
                                        selectedRows="{!v.displayZipCode}"/>
                                </div>
                            </lightning:layoutItem>
                        </aura:if>
 
                    </lightning:layout>
                </lightning:card>
            </div>
        </aura:if>
    </aura:if>

    <!-- For Add: -->
    <aura:if isTrue="{!v.isOperation}">
        <div class="cardFilters" style="margin-bottom:7px">  
            <lightning:card title="{!$Label.c.XC_CL_MassAssSkillChooseFilter}" iconName="utility:center_align_text">
                <lightning:layout verticalAlign="center" horizontalAlign="center">
                        
                    <!-- Tabella delle Worktype per Partner selezionato e Operazione ADD: -->
                    <lightning:layoutItem padding="around-small" flexibility="auto">
                        <h1 style="text-align:center;"><b>{!$Label.c.XC_CL_MassAssSkill_SkillPartner}</b></h1>
                        <lightning:input 
                            type="text"
                            name="searchWorktype"
                            label="{!$Label.c.XC_CL_MassAssSkill_FilterSkill}"
                            value="{!v.filterWorktype}"
                            variant="label-hidden"
                            onchange="{!c.onChangeFilterWorktype}"
                            placeholder="{!$Label.c.XC_CL_MassAssSkill_FilterSkill}"
                        />
                        <div style="margin-bottom:20px;height: 300px; width: 300px">
                            <h1 style="text-align:center;"><b>{!$Label.c.XC_CL_MassAssSkill_SelectedRow}:&nbsp;</b> {!v.selectedRowsCountWorktype}</h1>
                            <lightning:datatable
                                title="{!$Label.c.XC_CL_MassAssSkillTableSkill}"
                                columns="{!v.columnsWorktype}"
                                data="{!v.dataWorktype}"
                                aura:id="tableWorktypeForAdd" 
                                keyField="Id"
                                selectedRows="{!v.displayWorktype}"
                                onrowselection="{!c.onChangeTableWorktype}"
                                sortedBy="Name"
                                defaultSortDirection="asc"
                                sortedDirection="asc"
                                />
                        </div>
                    </lightning:layoutItem>
                    
                    <!-- Tabella delle Province per Partner selezionato e Operazione ADD: -->
                    <aura:if isTrue="{!v.isWorktypeSelectedForAdd}">
                        <lightning:layoutItem padding="around-small" flexibility="auto">
                            <h1 style="text-align:center;"><b>Provinces:</b></h1>
                            <lightning:input 
                                type="text"
                                name="searchProvince"
                                label="{!$Label.c.XC_CL_MassAssSkill_FilterProvince}"
                                onchange="{!c.onChangeFilterProvince}"
                                value="{!v.filterProvince}"
                                variant="label-hidden"
                                placeholder="{!$Label.c.XC_CL_MassAssSkill_FilterProvince}"
                            />
                            <div style="margin-bottom:20px;height: 300px; width: 300px">
                                <h1 style="text-align:center;"><b>{!$Label.c.XC_CL_MassAssSkill_SelectedRow}:&nbsp;</b> {!v.selectedRowsCountProvince}</h1>
                                <lightning:datatable
                                    title="List of Provinces"
                                    columns="{!v.columnsProvince}"
                                    data="{!v.dataProvinces}"
                                    aura:id="tableProvinceForAdd" 
                                    keyField="Id"
                                    selectedRows="{!v.displayProvince}"
                                    onrowselection="{!c.onChangeTableProvince}"/>
                            </div> 
                        </lightning:layoutItem>
                    </aura:if> 

                    <!-- Tabella degli Zip Code per Partner selezionato e Operazione ADD: --> 
                    <aura:if isTrue="{!v.isSelectedProvince}">
                        <lightning:layoutItem padding="around-small" flexibility="auto">
                            <h1 style="text-align:center;"><b>Zip Codes:</b></h1>
                            <lightning:input 
                                type="text"
                                name="searchZipCodeAdd"
                                label="{!$Label.c.XC_CL_MassAssSkill_FilterZipCode}"
                                onchange="{!c.onChangeFilterZipCodeAdd}"
                                variant="label-hidden"
                                value="{!v.filterZipCodeAdd}"
                                placeholder="{!$Label.c.XC_CL_MassAssSkill_FilterZipCode}"
                            />
                            <div style="margin-bottom:20px;height: 300px; width: 300px">
                                <h1 style="text-align:center;"><b>{!$Label.c.XC_CL_MassAssSkill_SelectedRow}:&nbsp;</b> {!v.selectedRowsCountZipcodeForAdd}</h1>
                                <lightning:datatable
                                    title="List of ZipCodes"
                                    columns="{!v.columnsZipCodeAdd}"
                                    data="{!v.dataAddZipcode}"
                                    aura:id="tableZipcodeForAdd" 
                                    keyField="Id"
                                    selectedRows="{!v.displayZipcodeAdd}"
                                    onrowselection="{!c.onChangeTableZipCodeAdd}"/>
                            </div> 
                        </lightning:layoutItem>
                    </aura:if>

                </lightning:layout>
            </lightning:card>
        </div>
    </aura:if>

    <aura:if isTrue="{!and(v.isOptionSelected, v.isDestinationPartner)}">
        <div class="cardDestinationPartner" style="margin-bottom:7px">
            <lightning:card title="{!$Label.c.XC_CL_MassAssSkillDestinationPartner}" iconName="utility:change_owner">
                <lightning:layout verticalAlign="left" horizontalAlign="left">
                    <lightning:layoutItem padding="around-small" flexibility="auto" size="5">
                        <c:strike_lookup
                            label="{!$Label.c.XC_CL_MassAssSkillSelectDestination}"
                            object="Account"
                            searchField="Name"
                            placeholder="{!$Label.c.XC_CL_MassAssSkillHolderDestination}"
                            iconName="standard:account"
                            order="Name"
                            limit="5"
                            loadingMessage="{!$Label.c.XC_CL_MassAssSkillLoadingDestination}"
                            errorMessage="{!$Label.c.XC_CL_MassAssSkillErrorDestination}"
                            showRecentRecords="true"
                            value = "{!v.destinationPartner}"
                            required="true"
                            filter="{!v.filterStrikeLookupDestination}"/>
                    </lightning:layoutItem>
                </lightning:layout>
            </lightning:card>
        </div>
    </aura:if>

    <aura:if isTrue="{!v.readyButton}">
            <div class="forceChangeRecordTypeFooter slds-float--right slds-m-around--medium">
                <lightning:layout verticalAlign="right" horizontalAlign="right">
                        <lightning:layoutItem padding="around-small" flexibility="auto">
                            <lightning:button variant="brand" label="{!v.textButton}" title="{!v.textButton}" onclick="{!c.operation}" disabled="{!v.disableButton}"/>
                    </lightning:layoutItem> 
                </lightning:layout>
            </div>
    </aura:if>

    <aura:if isTrue="{!v.spinnerControl}">
        <div class="spinnerHolder">
            <lightning:spinner alternativeText="Loading" size="large" variant="brand" />
        </div> 
    </aura:if>

    <aura:if isTrue="{!v.spinnerControlLoadWorkType}">
        <div class="spinnerHolder">
            <lightning:spinner alternativeText="Loading" size="large" variant="brand" />
        </div> 
    </aura:if>

</aura:component>