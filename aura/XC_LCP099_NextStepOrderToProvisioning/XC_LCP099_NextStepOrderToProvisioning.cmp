<!--
* @author Monica Cutillo monica.cutillo@nttdata.com - Chiara Turco cturco@deloitte.it
* @date Creation 14/03/2019
* @date Modification dd/mm/yyyy
* @description Component to manage Compliant Verification and Start Provisioning for an Order
-->
<aura:component controller= "XC_LCC099_NextStepOrderToProvisioning" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,force:hasSObjectName,lightning:availableForFlowScreens" access="global" >

<aura:attribute name="recordId" type="String" />
<lightning:notificationsLibrary aura:id="notifLib"/>
<aura:handler name="init" value="{!this}" action="{!c.init}"/>
<aura:attribute name="isPromocodeApplicationWarning" type="boolean" default="false"/>
    
   <div class="slds-align_absolute-center" style="position: relative; height: 200px; ">
      <aura:if isTrue="{!v.isPromocodeApplicationWarning}">
         <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open slds-modal_medium">
             <div class="slds-modal__container" style="background-color: white; top:300px; height:500px; ">
                 <header class="slds-modal__header">
                     <lightning:buttonIcon iconName="utility:close" onclick="{! c.closeModal}" alternativeText="close" variant="bare-inverse" class="slds-modal__close"/>
                     <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!$Label.c.XC_CL_Warning}</h2>
                 </header>
                 <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                     <p>{!$Label.c.XC_CL_PromocodeApplicationWarning}</p>
                 </div>
                 <footer class="slds-modal__footer">
                     <lightning:button variant="neutral" label="Cancel" title="Cancel" onclick="{! c.closeModal}"/>
                     <lightning:button variant="brand" label="OK" title="OK" onclick="{!c.okPromocode}"/>
                 </footer>
             </div>
         </section>
         <!--div class="slds-backdrop slds-backdrop_open"></div-->

         <aura:set attribute="else">
                <lightning:spinner aura:id="mySpinner" alternativeText="Loading" size="medium" />
        </aura:set>

     </aura:if>
   </div>

</aura:component>