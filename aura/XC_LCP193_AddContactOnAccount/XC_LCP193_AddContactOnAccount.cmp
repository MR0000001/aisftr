<aura:component
                controller="XC_LCC052_SelectAvaibleAccountFromIndiv"
                implements="force:hasRecordId,force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,force:hasSObjectName,lightning:availableForFlowScreens,lightning:isUrlAddressable,lightning:hasPageReference,force:lightningQuickActionWithoutHeader" access="global" >

    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="recordTypeId" type="String" />
    <aura:attribute name="sourceObjType" type="String" />
    <aura:attribute name="showContactOpt" type="Boolean" default="false" />
    <aura:attribute name="title" type="String" default="{!$Label.c.XC_CL_Contact_ChooseAnAccount}"/>
    <aura:attribute name="titleOpp" type="String" default="{!$Label.c.XC_CL_Opportunity_Setting}"/>
    <aura:attribute name="showFooter" type="Boolean" default="true" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />
    <aura:attribute name="contactOptions" type="List" />
    <aura:attribute name="description" type="String" />
    <aura:attribute name="modelValue" type="String" />
    <aura:attribute name="contactValue" type="String" />
    <aura:attribute name="disableConfirm" type="Boolean" default="true" />
    
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler name="change" value="{!v.contactValue}" action="{!c.changeData}"/>

    <ltng:require styles="{!$Resource.XC_STR004_CompWidth100}" />
    <div class="c-container">

        <c:strike_modal
                title=""
                primaryButtonLabel="Ok"
                secondaryButtonLabel="Cancel"
                showHeader="false"
                showFooter="false"
                showClose="false"
                showModal="true">

            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="2" >
                    <div class="custom-box"></div>
                </lightning:layoutItem>
                <lightning:layoutItem size="8" >

                    <header class="slds-modal__header">
                        <h1 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.titleOpp}</h1>
                    </header>

                    <div class="slpadding2"></div>
                    <lightning:combobox aura:id="ChooseContact" name="ChooseContact" label="{!$Label.c.XC_CL_Contact}" 
                                        placeholder="{!$Label.c.XC_CL_Contact_ChooseAContact}" value="{! v.contactValue }" 
                                        options="{! v.contactOptions }" disabled="false" variant='label-inline' required="true"/>

                    <div class="slpadding2"></div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral"
                                            label="{!$Label.c.XC_CL_CancelButton}"
                                            title="Cancel"
                                            onclick="{! c.closeModal }"/>

                        <lightning:button variant="brand"
                                            label="{!$Label.c.XC_CL_ConfirmButton}"
                                            title="Submit"
                                            disabled="{! v.disableConfirm}"
                                            onclick="{!c.onConfirm}"/>
                    </footer>
                    
                </lightning:layoutItem>
            </lightning:layout>
        </c:strike_modal>
    </div>
</aura:component>