<!--
* @author Giulio Proia, Monica Cutillo, Francesco Bongiovanni
* @date Creation 24/09/2018
* @description XC_LCP017_DataTable – Show an object list as table, with the possibility to select an element and confirm the selection to perform a custom action.
-->
<aura:component implements="force:appHostable,force:lightningQuickActionWithoutHeader,force:hasRecordId" access="global" >
<aura:attribute name="data" type="List"/>
<aura:attribute name="columns" type="List"/>
<aura:attribute name="title" type="String"/>
<aura:attribute name="recordId" type="String"/>
<aura:attribute name="errorMessage" type="String" default="no row found"/>
<aura:attribute name="Selected" type="List"/>
<aura:attribute name="maxRowSelection" type="Integer" default="2"/>
<aura:attribute name="isModal" type="Boolean"/>
<aura:attribute name="disabled" type="Boolean" default="true"/>
<aura:attribute name="isWithSelection" type="Boolean" default="false"/>
<aura:attribute name="isSubmitVisible" type="Boolean" default="true"/>
<aura:attribute name="isMultipleSelection" type="Boolean" default="false"/>
<aura:attribute name="resizeColumnDisabled" type="Boolean" default="false"/>
<aura:attribute name="selectedRowsCount" type="Integer" default="0"/>
<aura:attribute name="spinner" type="boolean" default="false"/>

<aura:registerEvent name="sendRows" type="c:XC_LCE011_DataTable"/>
<aura:if isTrue="{!v.isModal}">
<div class="modal-header slds-modal__header slds-size_1-of-1">
       <h4 class="title slds-text-heading_medium" >{!v.title}</h4>  
    </div>
  </aura:if>
<lightning:card title="">

  <aura:if isTrue="{!v.data[0]}">
    <div style="height: 300px">
    <aura:if isTrue="{! v.isWithSelection}">
        
      <lightning:datatable
        title="{! v.title }"
        keyField="id"
        data="{! v.data }"
        columns="{! v.columns }"
        selectedRows= "{! v.Selected }"
        maxRowSelection="{! v.maxRowSelection }"
        onrowselection="{!c.updateSelectedRows}"
        resizeColumnDisabled="{! v.resizeColumnDisabled }"
      />
      <aura:set attribute="else">
        <aura:if isTrue="{! v.isMultipleSelection}">
          <h1>Selected Rows: {! v.selectedRowsCount }</h1>
          <lightning:datatable
            title="{! v.title }"
            keyField="id"
            data="{! v.data }"
            columns="{! v.columns }"
            selectedRows= "{! v.Selected }"
            onrowselection="{!c.updateSelectedRows}"
            resizeColumnDisabled="{! v.resizeColumnDisabled }"
          /><!--maxRowSelection="200"-->
          <aura:set attribute="else">
            <lightning:datatable
              title="{! v.title }"
              keyField="id"
              data="{! v.data }"
              columns="{! v.columns }"
              hideCheckboxColumn="true"
            />
          </aura:set>
        </aura:if>
      </aura:set>
    </aura:if>
    </div>
<lightning:layoutItem padding="around-small">
      <aura:if isTrue="{! !v.isModal}">
        <lightning:button variant="brand" label="{!$Label.c.XC_CL_ConfirmButton}" title="Submit" onclick="{! c.sendEvent }" disabled="{!v.disabled}"/>
      </aura:if>
    </lightning:layoutItem>
    <aura:if isTrue="{!v.isModal}">
      <div class="modal-footer slds-modal__footer slds-size_1-of-1">

        <div class="forceChangeRecordTypeFooter">
            <lightning:button  label="{!$Label.c.XC_CL_CancelButton}" title="Submit" onclick="{! c.cancel }"/>
            <aura:if isTrue="{!v.isSubmitVisible}">
              <lightning:button variant="brand" label="{!$Label.c.XC_CL_ConfirmButton}" title="Submit" onclick="{! c.sendEvent }" disabled="{!v.disabled}"/>
            </aura:if>
          </div>
      </div>
    </aura:if>
    <aura:set attribute="else">
      <h3>{!v.errorMessage}</h3>
    </aura:set>
  </aura:if>
</lightning:card>

</aura:component>