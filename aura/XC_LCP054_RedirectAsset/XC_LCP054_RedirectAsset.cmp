<aura:component controller="XC_LCC054_RedirectAsset" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable,lightning:hasPageReference" access="global" >

    <aura:attribute name="recordTypeId" type="String"/>
    <aura:attribute name="accountId" type="String" />
    <aura:attribute name="catalogCategory" type="String"/>
    <aura:attribute name="catalog" type="String"/>
    <aura:attribute name="contactId" type="String" />
    <aura:attribute name="description" type="String" />
    <aura:attribute name="modelValue" type="String" /> 
    <aura:attribute name="podId" type="String" />
    <aura:attribute name="fromContact" type="Boolean" default="false"/>
    <aura:attribute name="initRedirect" type="Boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.init}" />

  
    <aura:if isTrue = "{!v.initRedirect}">
    <c:XC_LCP000_RedirectLogicNewSobject objectName="Asset" 
    	objectPrefix="02i" 
    	recordId="{!v.recordId}" 
    	accountId="{!v.accountId}" 
    	contactId="{!v.contactId}" 
    	catalogCategory="{!v.catalogCategory}" 
    	catalog="{!v.catalog}" 
    	podId="{!v.podId}"
    	recordTypeId="{!v.recordTypeId}"
        fromContact= "{!v.fromContact}"
        description="{!v.description}"
        modelValue="{!v.modelValue}"
    	/>
	</aura:if>

</aura:component>