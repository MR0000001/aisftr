<aura:component controller="XC_LCC191_ExternalOTPSignature" access="global"
    implements="forceCommunity:availableForAllPageTypes,force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,force:lightningQuickActionWithoutHeader">

    <!-- <ltng:require styles="{!$Resource.XC_STR004_CompWidth100}" /> -->
    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
    <aura:attribute name="notCloseModal" type="Boolean" default="false"/>

    <lightning:notificationsLibrary aura:id="notifLib"/>
    
    <div style="position: fixed; top: 0; right: -532px; bottom: 0; left: -532px; z-index: 9998; background-color: white">
        <lightning:spinner aura:id="mySpinner" />
    </div>

</aura:component>