<aura:component controller="TA_LCC233_QuoteSummary"
    implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,lightning:actionOverride,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable"
    access="global">

    <aura:attribute access="public" name="fieldSet" type="String" />
    <aura:attribute access="public" name="workOrder" type="Object" />
    <aura:attribute access="public" name="showToastMessage" type="Boolean" />
    <aura:attribute access="public" name="isError" type="Boolean" />
    <aura:attribute access="public" name="toastMessage" type="String" />

    <aura:attribute access="private" name="general" type="Object" />
    <aura:attribute access="private" name="custom" type="Object" />
    <aura:attribute access="private" name="customerCardBg" type="String" />
    <aura:attribute access="private" name="quotes" type="List" />
    <aura:attribute access="private" name="isInitialized" type="Boolean" />
    <aura:attribute access="private" name="selectedQuotationId" type="String" />
    <aura:attribute access="private" name="selectedQuotationOpptyId" type="String" />
    <aura:attribute access="private" name="updateAllQuote" type="Object" />
    <aura:attribute access="private" name="nextStepCallback" type="Object" />

    <ltng:require styles="{!join(',',
                            $Resource.TA_CSS + '/TA_CSS/slds-override.css',
                            $Resource.TA_CSS + '/TA_CSS/ta-classes-mobile.css',
                            $Resource.TA_CSS + '/TA_CSS/ta-classes-tablet.css')}" />

    <aura:handler name="init" action="{!c.handleInitialize}" value="{!this}" />
    <aura:handler event="c:TA_LCE233_QuoteSummary" action="{!c.handleQuoteSummaryEvt}" />
    <aura:handler name="change" value="{!v.selectedQuotationOpptyId}" action="{!c.handleChangeSelectedQuoteOppty}"/>

    <aura:registerEvent name="toggleSpinnerEvent" type="c:TA_LCE213_StartSpinnerEvt" />
    <aura:registerEvent name="sendInitStateEvt" type="c:TA_LCE220_SendInitStateEvt" />
    <aura:registerEvent name="TA_LCE233_QuoteSummary" type="c:TA_LCE233_QuoteSummary" />

    <c:TA_LCP236_ToastMessage showToastMessage="{!v.showToastMessage}" isError="{!v.isError}" toastMessage="{!v.toastMessage}" />

    <aura:if isTrue="{!v.isInitialized}">
        <aura:iteration items="{!v.quotes}" var="quote">
            <div class="ta-box-custom-margin" style="{!'background:' + v.general.bgColor + ', url(' + v.customerCardBg +'); background-size: cover; border-radius: 2.5vw;
            background-position: ' + v.general.bgPosition + '; box-shadow: 0vw 1vw 2vw -0.8vw black; background-blend-mode: lighten; padding: 5vw;'}">
                <lightning:layout multipleRows="true">
                    <lightning:layoutItem size="12">
                        <lightning:layout multipleRows="true">
                            <lightning:layoutItem size="10">
                                <lightning:layout multipleRows="true">

                                    <lightning:layoutItem size="12">
                                        <h3 class="ta-color-white"> {!quote.name} </h3>
                                    </lightning:layoutItem>

                                    <lightning:layoutItem size="12" class="slds-m-top_xx-small">
                                        <h3 class="ta-color-white-opacity-60"> {!quote.oneTimeFeeTotal} € </h3>
                                    </lightning:layoutItem>

                                </lightning:layout>
                            </lightning:layoutItem>
                            <lightning:layoutItem size="2">
                                <img src="{!$Resource.TA_Icons + '/xc-icons/' + v.general.iconName}" class="slds-float_right ta-accordion-header-icon"/>
                            </lightning:layoutItem>

                            <lightning:layoutItem size="6" class="slds-p-top_medium slds-text-align_left">
                                <span class="ta-accordion-header-button" id="{!quote.id}" onclick="{!c.handleShowDetails}">
                                    {!if(quote.show == false, $Label.c.TA_QuoteSummaryShowDetails, $Label.c.TA_QuoteSummaryCloseDetails)}
                                </span>
                            </lightning:layoutItem>

                            <lightning:layoutItem size="6" class="slds-p-top_medium slds-text-align_right">
                                <aura:if isTrue="{!not(v.custom.showAcceptedQuote == 'true')}">
                                    <aura:if isTrue="{!v.selectedQuotationId == quote.id}">
                                        <span class="ta-quote-accepted slds-text-align_center"> {!$Label.c.TA_QuoteSelected} </span>
                                        <aura:set attribute="else">
                                            <span id="{!quote.id}" class="ta-accordion-header-button" onclick="{!c.handleQuoteSelection}">
                                                {!$Label.c.TA_SelectQuote}
                                            </span>
                                        </aura:set>
                                    </aura:if>
                                </aura:if>
                            </lightning:layoutItem>
                        </lightning:layout>
                    </lightning:layoutItem>  

                    <aura:if isTrue="{!quote.show}">
                        <lightning:layoutItem size="12">
                            <aura:iteration items="{!quote.items}" var="item">
                                <lightning:layout multipleRows="true" class="slds-p-top_large ta-border-top-white slds-m-bottom_large">
                                    <lightning:layoutItem size="8">
                                        <lightning:layout multipleRows="true" class="slds-text-align_left">
                                            <lightning:layoutItem size="12" class="slds-m-bottom_medium"> <p class="ta-color-white ta-font-weight-800"> {!item.transletedProdName} </p></lightning:layoutItem>
                                            <lightning:layoutItem size="12" class="ta-item-payment">{!item.billingModel}</lightning:layoutItem>
                                        </lightning:layout>
                                    </lightning:layoutItem>

                                    <lightning:layoutItem size="4">
                                        <lightning:layout multipleRows="true" class="slds-text-align_right">
                                            <lightning:layoutItem size="12" class="slds-m-bottom_medium slds-text-align_right slds-float_right">
                                                <div class="ta-quantity"> {!item.qty} </div>
                                            </lightning:layoutItem>
                                            <lightning:layoutItem size="12"> <h3 class="ta-color-white"> {!item.oneTimeFee} € </h3></lightning:layoutItem>
                                        </lightning:layout>
                                    </lightning:layoutItem>
                                </lightning:layout>
                            </aura:iteration>
                        </lightning:layoutItem>
                        <aura:if isTrue="{!not(v.custom.showAcceptedQuote == 'true')}">
                            <lightning:layoutItem size="6" class="slds-p-top_medium slds-text-align_left">
                                <span id="{!quote.id}" name="button-edit" class="ta-accordion-header-button" onclick="{!c.handleManageEdit}">
                                    {!$Label.c.TA_Edit}
                                </span>
                            </lightning:layoutItem>
                            <!-- <lightning:layoutItem size="6" class="slds-p-top_medium slds-text-align_right">
                                <span id="{!quote.id}" name="button-add-more" class="ta-accordion-header-button" onclick="{!c.handleManageEdit}">
                                    Add More
                                </span>
                            </lightning:layoutItem> -->
                        </aura:if>
                    </aura:if>
                </lightning:layout>
            </div>
        </aura:iteration>
    </aura:if>
</aura:component>