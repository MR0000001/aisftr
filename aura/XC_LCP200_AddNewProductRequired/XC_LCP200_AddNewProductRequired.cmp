<aura:component controller ="XC_LCC200_AddNewProductRequired" implements="forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:hasPageReference,lightning:actionOverride,flexipage:availableForRecordHome,force:hasRecordId" access="global" >
	<aura:attribute name="confItemCommercial" type="NE__OrderItem__c[]"/>
   
    <aura:attribute name="selectConfComm" type="boolean" default="false"/>
    <aura:attribute name="disableSelect" type="boolean" default="true"/>
    <aura:attribute name="idSelectConfComm" type="string" default=""/>
    <aura:attribute name="wbeElement" type="string" default=""/>
    <aura:attribute name="costCenter" type="string" default=""/>
    <aura:handler name="init" action="{!c.doInit}" value="{!this}"/>
    <aura:attribute name="parentRecordId" type="String" default=""/>
    <aura:attribute name="body1" type="Object[]" />
    <aura:attribute name="manageCommunity" type="Boolean" default="false"/>
    <lightning:workspaceAPI aura:id="workspace"/>

        {!v.body1}

    <aura:if isTrue="{!!v.manageCommunity}">
        <div aura:id="editDialog" role="dialog" tabindex="-1" aria-labelledby="header43" class="slds-modal slds-fade-in-open">
            <div class="slds-modal__container">
                 <div class="slds-modal__header">
                        <h2 class="slds-text-heading--medium">Order Material</h2>
                         <div class="slds-form-element">

                             <lightning:select name="select1" onchange="{!c.onPicklistChange}" label="Related Commercial Item " class="customCls">
                                  <option value="--none--">-none-</option>/>
                                 <aura:iteration items="{!v.confItemCommercial}" var="listView">

                                    <option value="{!listView.Id}">{!listView.Name}&nbsp;-&nbsp;{!listView.NE__ProdName__c}</option>/>
                                </aura:iteration>
                            </lightning:select>
                        </div>


                </div>

                    <div class="slds-modal__footer">
                        <lightning:button variant="neutral" label="{!$Label.c.XC_CL_CancelButton}" onclick="{!c.cancelDialog}"/>
                        <aura:if isTrue="{!v.selectConfComm}">
                            <lightning:button disabled="{!v.disableSelect}" variant="brand" label="{!$Label.c.XC_CL_SelectConfigurationItem}" onclick="{!c.callSaveComp}" />
                        </aura:if>
                    </div>

            </div>
        </div>
        <div aura:id="overlay" class="slds-backdrop slds-backdrop--open"></div>
    </aura:if>
</aura:component>