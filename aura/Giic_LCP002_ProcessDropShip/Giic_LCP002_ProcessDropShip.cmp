<aura:component controller="Giic_LCC002_ProcessDropShip" 
                implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,lightning:actionOverride,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,force:hasSObjectName" access="global">
    <aura:attribute name="recordId" type="Id"/>
    <aura:attribute name="purchaseOrder" type="gii__PurchaseOrder__c"/>
	<aura:attribute name="lightValue" type="String" default=""/>
    <aura:attribute name="cmpTitle" type="String" default="Process DropShip"/>
    <aura:attribute name="sobjectType" type="String" default="{!v.sObjectName}"/>
    <aura:attribute name="purchaseOrderFields" type="String[]" default="Name,gii__SupplierName__c,giic_Status__c,gii__DropShip__c,giic_Contract__c, giic_LegalEntity__c"/>
    <aura:attribute name="columns" type="List"/>  
    <aura:attribute name="mapPolToSerialList" type="Map" default="{}"/>
    <aura:attribute name="totalLotMap" type="Map" default="{}"/>
    <aura:attribute name="deliveryDoc" type="String" />
    <aura:attribute name="deliveryDate" type="Date" default="" />
    <aura:attribute name="errors" type="Object" default="[]"/>
     <aura:attribute name="mapPolIdToQuantity" type="Map" default="{}"/>
    <aura:attribute name="error" type="String" default=""/>
    <aura:attribute name="draftValues" type="gii__PurchaseOrderLine__c" default="[]"/>
    <aura:attribute name="linesFromServer" type="gii__PurchaseOrderLine__c" default="[]"/>
    <aura:attribute name="receiptDate" type="Date" default="" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />   

    <aura:attribute name="ReadOnly2246" type="Boolean" default="false"/>
    <aura:attribute name="QualityNote2246" type="Boolean" default="false"/> 
    <aura:attribute name="qualityControl" type="Boolean" default="false"/>
    <aura:attribute name="qualityNoteRequire" type="Boolean" default="false"/>
    <aura:attribute name="qualityFail" type="Boolean" default="false"/>
    <aura:attribute name="arrivalMaterial" type="Date" default=""/>
    <aura:attribute name="qualityNote" type="String" default=""/>
    <aura:attribute name="isActiveNR2626" type="Boolean" default="false"/>
    


    
    <aura:attribute name="currentPolSelected" type="gii__PurchaseOrderLine__c"  /> 
    <aura:attribute name="isDropShip" type="Boolean" default="true" /> 
    <aura:attribute name="isRequired" type="Boolean" default="true" /> 
    <aura:attribute name="sblokSubmit" type="Boolean" default="true" /> 
    <aura:attribute name="actualRow" type="Integer"  /> 
    <aura:attribute name="lineSelected" type="Boolean" default="false" /> 
    <aura:attribute  name="POrderLineList" type="List"/> 
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <aura:attribute name="data" type="List"/>
    <aura:handler event="c:XC_LCE005_SendSerialNumber" action="{!c.setSerialMap}"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" /> 
    <force:recordData aura:id="purchaseOrderRecord"
                        recordId="{!v.recordId}"
                        targetFields="{!v.purchaseOrder}"
                        fields="Name,gii__SupplierName__c,giic_Status__c,gii__DropShip__c,giic_Contract__c, giic_LegalEntity__c"
                        layoutType="FULL"/>
    <ltng:require styles="{!$Resource.XC_STR004_CompWidth100}" /> 
    <div class="c-container">
	 
        <div class="slds-box slds-theme_shade">
    <div class="slds-text-heading_large">
         <lightning:icon iconName="standard:partner_fund_allocation" alternativeText="Approved" />&nbsp;
          <aura:if isTrue="{!v.isDropShip}">
        <b> Process DropShip  </b>
         <aura:set attribute="else">
         <b> Receive   </b>
              </aura:set>
        </aura:if>
            </div>
 </div> 
        
        <aura:if isTrue="{!v.showSpinner}">
        <lightning:spinner aura:id="mySpinner" />
        </aura:if>
        
        
        <div class="c-container">
         <lightning:layout verticalAlign="center" horizontalAlign="center" >
              <lightning:layoutItem size = "3" padding="around-small">
                    <div class="custom-box2">
                        <lightning:card variant="Narrow" iconName="standard:record_update">
                            <aura:set attribute="title">
                                <h4>Enter the mandatory <br></br> informations</h4>
                            </aura:set>
                        </lightning:card>
                    </div>
                </lightning:layoutItem>
               <lightning:layoutItem size = "3" padding="around-small">
                    <div class="custom-box2">
                        <lightning:card variant="Narrow" iconName="custom:custom83">
                            <aura:set attribute="title">
                                <h4>Change received quantity <br></br> on lines and save</h4>
                            </aura:set>
                        </lightning:card>
                    </div>
                </lightning:layoutItem>
                  <lightning:layoutItem size = "3" padding="around-small">
                    <div class="custom-box2">
                        <lightning:card variant="Narrow" iconName="standard:marketing_actions">
                            <aura:set attribute="title">
                                <h4>Select one line to insert <br></br>serials and 'save serials'</h4>
                            </aura:set>
                        </lightning:card>
                    </div>
                </lightning:layoutItem>
               <lightning:layoutItem size = "3" padding="around-small">
                    <div class="custom-box2">
                        <lightning:card variant="Narrow" iconName="standard:work_order_item">
                            <aura:set attribute="title">
                                <h4>Click {!v.cmpTitle} button to<br></br> confirm the data entered</h4>
                            </aura:set>
                        </lightning:card>
                    </div>
                </lightning:layoutItem>
               
            </lightning:layout>
             </div><br></br>
        
        
    
          <lightning:tabset>
           <lightning:tab label="Mandatory Informations" iconName="utility:edit">
             <lightning:layout>
            <lightning:layoutItem size = "6" padding="around-small">
                  <lightning:recordForm aura:id="purchaseForm"
                                recordId="{!v.recordId}"
                                objectApiName="gii__PurchaseOrder__c"
                                fields="{!v.purchaseOrderFields}"
                                columns="1"
                                mode="readonly"
                                onload="{!c.manageData}" />
            </lightning:layoutItem>            
            <lightning:layoutItem size = "6" padding="around-small">
          
                 <lightning:input type="date" name="date1" label="Registration Date" required="true"  value="{!v.receiptDate}" onchange="{!c.checkReq}" disabled="{!v.isActiveNR2626}"/>
                 <lightning:input type="text" name="deliveryD" label="Transportation Document Number" required="{!v.isRequired}"  value="{!v.deliveryDoc}"  onchange="{!c.checkReq}"  />
                <!--<lightning:input type="date" name="date2" label="Transportation Document Date"       required="{!v.isRequired}"  value="{!v.deliveryDate}" onchange="{!c.checkReq}" />-->

                <aura:if isTrue="{!v.isActiveNR2626}">
                 <lightning:input type="date" name="date2" label="Transportation Document Date"       required="{!v.isRequired}"  value="" onchange="{!c.checkReq}" />
                 <lightning:input type="checkbox" name="QualityRequired" label="Quality and Quantity Check" required="true" checked="{!v.qualityNoteRequire}" onchange="{!c.checkReq}" />
                 <lightning:input type="checkbox" name="QualityFailed" label="Quality and Quantity check Failed" checked="{!v.qualityFail}" onchange="{!c.checkNoteRequired}"  />
                 <lightning:input type="text" name="QualityNote " label="Quality and Quantity Check note" value="{!v.qualityNote}" required="{!v.QualityNote2246}" onchange="{!c.checkReq}" /> 
                 <lightning:input type="date" name="MaterialArrive" label="Arrival Material" required="true" value="{!v.arrivalMaterial}" onchange="{!c.checkReq}"/>
                    <aura:set attribute="else">
      					<lightning:input type="date" name="date3" label="Transportation Document Date"       required="{!v.isRequired}"  value="{!v.deliveryDate}" onchange="{!c.checkReq}" />
    				</aura:set>
                </aura:if>
               
                 </lightning:layoutItem>
            </lightning:layout>
              </lightning:tab>
              <lightning:tab label="Purchase Order Lines" iconName="utility:table">
          
            <div style="text-align: center !important">
         <lightning:datatable aura:id="supertableId"
            columns="{! v.columns }"
            data="{! v.data }"
            keyField="Id"
            maxRowSelection="1"
            errors="{! v.errors }"
            draftValues="{! v.draftValues }"
            onsave="{! c.handleSaveLine }"
            onrowselection="{! c.updateSelectedRow }"/>  
                
                </div>
                  <br></br>             
                  
                  <div class="slds-box">
                  
                  
                    <lightning:layout>
            <lightning:layoutItem size = "12" padding="around-small">
                   <div class="slds-text-align_right">
                 <lightning:buttonGroup>
                 <lightning:button variant="neutral" 
                              label="{!$Label.c.XC_CL_Cancel}"
                              title="Cancel"
                              onclick="{! c.closeModal }"/>
            
            <lightning:button variant="brand" 
                              label="{!v.cmpTitle}"
                              title="save"
                              disabled="{!v.sblokSubmit}"
                              onclick="{! c.startReceipt }"/>  
                </lightning:buttonGroup>
                </div>
                        </lightning:layoutItem>
                  </lightning:layout>
         					 {!v.body}
                
        
         </div>
             
              </lightning:tab>
        </lightning:tabset>
    </div>
</aura:component>