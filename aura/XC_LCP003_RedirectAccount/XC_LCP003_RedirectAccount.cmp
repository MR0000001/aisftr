<aura:component  
    controller="XC_UTIL_Environment"
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable,lightning:hasPageReference" access="global" >

    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="recordTypeId" type="String"/>
    <aura:attribute name="showComponent" type="Boolean" default="false"/>
    <aura:attribute name="isCommunity" type="Boolean" default="false" />
	<!-- HANDLER -->
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
	
    <aura:if isTrue="{!v.showComponent}">
        <c:XC_LCP000_RedirectLogicNewSobject 
            objectName="Account" 
            recordId="{!v.recordId}" 
            recordTypeId="{!v.recordTypeId}"
            isCommunity="{!v.isCommunity}" />
    </aura:if>
    
</aura:component>