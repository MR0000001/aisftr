        </lightning:layout>

    </lightning:recordEditForm>-->

    <lightning:layout multipleRows="true">
        <lightning:layoutItem size="12">
            <aura:iteration items="{!v.addressFields}" var="field">
                <aura:if isTrue="{!field.isDisplayed}">       
                    <aura:if isTrue="{!v.disableFields}">
                        <!-- FIELD READONLY -->
                        <lightning:layoutItem size="12" class="slds-m-top_medium">
                            <lightning:layout multipleRows="true">
                                <lightning:layoutItem size="12">
                                    <div class="slds-float_left slds-form-element__label"> {!field.label} </div>
                                </lightning:layoutItem>
                                <lightning:layoutItem size="12">
                                    <p> {!field.value} </p>
                                </lightning:layoutItem>
                            </lightning:layout>   
                        </lightning:layoutItem>

                        <aura:set attribute="else">
                            <!-- FIELD PICKLIST -->
                            <aura:if isTrue="{!field.type == 'PICKLIST'}">
                                <lightning:layoutItem size="12" class="slds-m-top_medium">
                                    <lightning:select required="{!field.required}"
                                                    value="{!field.value}" label="{!field.label}" 
                                                    name="{!field.apiName}">
                                        <aura:iteration items="{!field.availableValues}" var="availableValue">
                                            <option value="{!availableValue.value}">{!availableValue.label}</option>
                                        </aura:iteration>
                                    </lightning:select>
                                </lightning:layoutItem>
                            </aura:if>

                            <!-- FIELD TEXT OR EMAIL OR NUMBER OR DATE -->
                            <aura:if isTrue="{!or(field.type == 'STRING', or(field.type == 'EMAIL', 
                                                or(field.type == 'NUMBER', or(field.type == 'DATE', field.type == 'DATETIME'))))}">
                                <lightning:input class="slds-m-top_medium" type="{!if(field.type == 'EMAIL', 'email', 
                                                                                    if(field.type == 'NUMBER', 'number', 
                                                                                    if(or(field.type == 'DATE',field.type == 'DATETIME'), 'date', 'text')))}" required="{!field.required}" 
                                                    label="{!field.label}" name="{!field.apiName}" value="{!field.value}" onchange="{!c.handleOnChangeEvent}"/>
                            </aura:if>

                            <!-- FIELD AUTOCOMPLETE SUGGESTIONS -->
                            <aura:if isTrue="{!v.showSugg}">
                                <div aura:id="{!field.apiName}" class="slds-dropdown_length-10" role="listbox">
                                    <ul aura:id="query-suggest-list" class="slds-listbox slds-listbox_vertical slds-textarea" role="presentation">
                                        <aura:iteration items="{!v.searchResult}" var="sugg" indexVar="index">
                                            <li aura:id="query-suggest-item" role="presentation" class="slds-listbox__item">
                                                <div aura:id="query-suggestions" id="{!sugg.value}" class="slds-media slds-listbox__option slds-listbox__option_plain slds-media_small" role="option" value="{!sugg}" onclick="{!c.selectCity}">
                                                    {!sugg.label}
                                                </div>
                                            </li>
                                        </aura:iteration>
                                    </ul>
                                </div>
                            </aura:if>

                            <!-- FIELD TEXTAREA -->
                            <aura:if isTrue="{!field.type == 'TEXTAREA'}">
                                <lightning:layoutItem size="12" class="slds-m-top_medium">
                                    <lightning:textarea required="{!field.required}" name="{!field.apiName}" 
                                                        label="{!field.label}" value="{!field.value}" onchange="{!c.handleOnChangeEvent}"/>
                                </lightning:layoutItem>
                            </aura:if>

                        </aura:set>
                    </aura:if> 
                </aura:if>        
            </aura:iteration>
        </lightning:layoutItem>
    </lightning:layout>


        <!--<aura:if isTrue="{!and(v.address.validate,not(v.showCheckbox))}">
            <lightning:input type="checkbox" label="{!$Label.c.XC_CL_Address_AddressValidated}" checked="{!v.address.validate}" disabled="true"/>
            <br></br>
        </aura:if>
    
        <br></br>
    <aura:if isTrue = "{!not(v.isSFMObject)}">
        <aura:if isTrue="{!v.showCheckbox}">
            <lightning:input aura:id="skipVal" type="checkbox" label="{!$Label.c.XC_CL_SaveWithoutValidate}" onchange="{!c.skipValidation}"/>
        </aura:if>
    </aura:if>
    <lightning:layout horizontalAlign="end">
        <lightning:layoutItem padding="around-small">

            <lightning:buttonGroup>

                <aura:if isTrue="{!and((v.source!='002'), (v.source!='003'))}">
                    <aura:if isTrue="{!or(v.showSave, v.isSFMObject)}">
                        <lightning:button aura:id="saveButton" disabled="{!and(not(v.address.validate),not(v.skipValChecked))}" variant="brand" label="{!$Label.c.XC_CL_SaveButton}" title="Brand action" onclick="{!c.saveAddress}" />
                    </aura:if>
                    <aura:if isTrue="{!(v.source!='013')}">
                        <lightning:button label="{!$Label.c.XC_CL_Cancel}" title="Brand action" onclick="{! c.cancel }" />
                    </aura:if>
                </aura:if>

                <aura:if isTrue="{!and(v.showButtonSection, not(v.isSFMObject))}">
                    <aura:if isTrue="{!and(not(v.skipValChecked),not(v.showCheckbox))}">   
                        <lightning:button label="{!$Label.c.XC_CL_Address_Validate}" onclick="{!c.onValidate}"/>
                    </aura:if>
                </aura:if>
                <aura:if isTrue ="{!not(v.isSFMObject)}">
                    <aura:if isTrue="{!not(v.showButtonSection)}">
                        <lightning:button aura:id="editButton" label="{!$Label.c.XC_CL_EditButton}" onclick="{!c.onModify}"/>
                    </aura:if>
                </aura:if>
            </lightning:buttonGroup>

        </lightning:layoutItem>
    </lightning:layout>-->

</aura:component>