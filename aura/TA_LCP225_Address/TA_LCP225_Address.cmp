                <aura:if isTrue="{!v.hiddenFields.XC_Region__c == null}">
					<lightning:inputField aura:id="region" fieldName="XC_Region__c" value="{!v.address.region}" disabled="{!v.address.country == 'Italy'}" onchange="{!c.sendChanges}"/>
                </aura:if>
                <aura:if isTrue="{!v.hiddenFields.XC_AddressProvince__c == null}">
                	<lightning:inputField aura:id="province" fieldName="XC_AddressProvince__c" onchange="{!c.setPickProvince }" required="true" disabled="true" value="{!v.address.province}" />
				</aura:if>
                
                <aura:if isTrue="{!and((v.address.country != 'Chile'),(v.address.country != 'Colombia'))}">
