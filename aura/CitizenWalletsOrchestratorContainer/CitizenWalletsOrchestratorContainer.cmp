<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global" >
	<aura:html tag="style">
        .slds-modal__container {
            max-width: 100rem !important;
            width: 100% !important;
            padding-top: 0;
        }
    </aura:html>
    
    <div class="slds-modal__container">
        <header class="slds-modal__header">
            <h2 id="modal-heading-01" class="slds-text-heading_medium slds-text-font_monospace slds-hyphenate">{!$Label.c.CitizenWallets_Title}</h2>
        </header>
        <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
            <c:citizenWalletsOrchestrator recordId="{!v.recordId}"/>
        </div>
    </div>
</aura:component>