<!--
* @author Monica Cutillo - monica.cutillo@nttdata.com
* @date Creation 31/01/2019
* @date Modification dd/MM/yyyy
* @description XC_LCP074_NewCaseByInsistenceModal
-->
<aura:component 
	implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:actionOverride,force:hasRecordId"
	controller="XC_LCC068_Care_NewCaseByInsistence" 
	access="global">

    <aura:attribute name="recordId" type="Id" /> 
    <aura:attribute name="isClosedWorkOrder" type="Boolean" />
    <aura:attribute name="isFromWorkOrder" type="Boolean" default="false" />
    <aura:attribute name="caseNumber" type="String" />
    <aura:attribute name="errorMessage" type="String" />
    <aura:attribute name="isOpen" type="boolean" default="false" />
    <aura:attribute name="spinnerControl" type="Boolean" default="true" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <div class="modal-header slds-modal__header slds-size_1-of-1">
       <h4 class="title slds-text-heading_medium" > {!$Label.c.XC_CL_InsistenceButton} </h4>  
    </div>
	
    <aura:if isTrue="{!v.spinnerControl}" >
        <div aura:id="masterSpinner"  class="slds-is-relative">
            <br></br><br></br><br></br><br></br><br></br><br></br>
            <lightning:spinner aura:id="mySpinner"/>
        </div>
    </aura:if>
	<aura:if isTrue="{!v.isOpen}">
        <p><b>{!format($Label.c.XC_CL_Warning_CaseClose, v.caseNumber)}</b></p>
		<br></br><br></br><br></br>
        
        <aura:if isTrue="{!!v.isFromWorkOrder}" >
    	    <div class="modal-footer slds-modal__footer slds-size_1-of-1">
    	        <div class="forceChangeRecordTypeFooter">
    	            <lightning:button  label="{!$Label.c.XC_CL_Close}" title="Close" onclick="{! c.close}"/>
    	        </div>
    	    </div>
        </aura:if>

        <aura:set attribute="else">
            <p><b>{!v.errorMessage}</b></p>
            <br></br><br></br><br></br>
        </aura:set>
    </aura:if>
</aura:component>