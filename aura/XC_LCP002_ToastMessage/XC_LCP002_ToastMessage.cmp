<aura:component >
	
	<aura:attribute name="message" type="String" default=""/>
    <aura:attribute name="type" type="String" default=""/>
    <aura:attribute name="errorMessages" type="String[]"/>

    <!-- HANDLER -->
    <aura:handler name="init" value="{!this}" action="{!c.init}" />

	<div class="slds-notify_container slds-is-fixed slds-m-top_xxx-large">


    		<div class="slds-notify slds-notify_toast" role="status" aura:id="toastDiv">

    			<span class="slds-icon_container slds-icon-utility-info slds-m-right_small slds-no-flex slds-align-top">
					<aura:if isTrue="{!'success'==v.type}">
	    				<lightning:icon iconName="action:approval" size="xx-medium" />
	    			</aura:if>
	    			<aura:if isTrue="{!'error'==v.type}">
	    				<lightning:icon iconName="action:close" size="xx-medium" />
	    			</aura:if>
    			</span>
    			<div class="slds-notify__content">
    			<aura:iteration items="{!v.errorMessages}" var="item">
				    <h2 class="slds-text-heading_small">26 potential duplicate leads were found. <a href="javascript:void(0);">Select Leads to Merge</a></h2>
				    <h2 class="slds-text-heading_small">26 potential duplicate leads were found. <a href="javascript:void(0);">Select Leads to Merge</a></h2>
    			</aura:iteration>

				</div>
		<div class="slds-notify__close">
		    <button class="slds-button slds-button_icon slds-button_icon-inverse" title="Close">
				
			<span class="slds-assistive-text">Close</span>
			</button>
			</div>
			</div>
	</div>

</aura:component>