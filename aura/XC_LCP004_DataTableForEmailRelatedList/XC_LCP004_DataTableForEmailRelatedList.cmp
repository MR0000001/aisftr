<aura:component controller="XC_LCC004_DataTableForEmailRelatedList" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global">
<aura:attribute name="columns" type="List" access="global"/>
<aura:attribute name="data" type="Object" access="global"/>
<aura:handler name="init" value="{!this}" action="{!c.init}"/>
<article class="slds-card">
  <div class="slds-card__header slds-grid">
    <header class="slds-media slds-media_center slds-has-flexi-truncate">
      <lightning:icon class="slds-icon slds-icon-standard-email-iq"  iconName="standard:email" alternativeText="Email List" /> 
        <div class="slds-assistive-text">{!$Label.c.XC_CL_EmailList}</div>
         <div class="slds-media__body">
          <h2 class="slds-card__header-title">
            <div class="slds-text-heading_small">{!$Label.c.XC_CL_EmailList}</div>
          </h2>
         </div>
        <div class="slds-no-flex">
          <lightning:button class="slds-button slds-button_brand" label="{!$Label.c.XC_CL_CheckUpdates}" onclick="{!c.init}"></lightning:button>
        </div>
    </header>
  </div>
</article>
  <div class="slds-card__body">
       <lightning:datatable 
            data="{! v.data }"
            columns="{! v.columns }"
            keyField="Id"
            hideCheckboxColumn="true"/> 
  </div>        
</aura:component>