<aura:component controller="XC_LCC192_BillingPreview" implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global" >
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name ="spinnerControl" type = "boolean" default = "false" />
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <div aura:id="MainDiv" class="slds-modal__container">
        <div class="slds-align_absolute-center slds-spinner--brand slds-spinner slds-spinner--medium slds-is-fixed" role="alert">
            <span class="slds-assistive-text">Loading</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
        </div>
    </div>


    <!--<aura:if isTrue= "{! !v.spinnerControl}">
        <div class="exampleHolder">
            <lightning:spinner alternativeText="Loading" size="medium" aura:id="mySpinner" />
        </div>
    </aura:if>-->

</aura:component>