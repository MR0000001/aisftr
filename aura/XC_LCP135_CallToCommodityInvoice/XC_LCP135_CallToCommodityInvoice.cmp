<!--
* @author Monica Cutillo - monica.cutillo@nttdata.com
* @date Creation 12/07/2019
* @date Modification 
* @description XC_LCP135_CallToCommodityInvoice – STUB Component to call Commodity System to retrieve Invoice Data
-->
<aura:component 
    extends="c:XC_LCP134_ViewFieldsBuilder"
    controller="XC_LCC132_CallToCommodityContract" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable,lightning:hasPageReference" access="global" >

    <aura:attribute name="invoiceCommodityObj" type="Object" />
    <aura:attribute name="spinnerControl" type="Boolean" default="false" />
    <aura:attribute name="loadPdf" type="Boolean" default="false" />
    <aura:attribute name="PDFData" type="Object" />
    <aura:attribute name="BaseURL" type="String" />
    <aura:attribute name="accountDocCountry" type="String" />
    <lightning:navigation aura:id="navService" />
    <lightning:workspaceAPI aura:id="workspace" />
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <aura:handler name="init" value="{!this}" action="{!c.init}" />
    <aura:handler name="XC_LCE018_CallReadInvoicePDF" event="c:XC_LCE018_CallReadInvoicePDF" action="{!c.handleCallReadInvoicePDF}"/>
    
    <lightning:card variant="Narrow" >
    </lightning:card>
    
    {!v.sectionBody}

    <aura:if isTrue="{!v.spinnerControl}" >
        <div style="position: fixed; top: 0; right: -532px; bottom: 0; left: -532px; z-index: 9998; background-color: white">
            <lightning:spinner aura:id="mySpinner" />
        </div>
    </aura:if>

    <!--<aura:if isTrue="{!v.loadPdf}" >
        <iframe src="{!v.BaseURL + '/apex/XC_VFP176_PDFGenerator?sourcePDFData=' + v.PDFData }" width="100%" height="500px;" frameBorder="0"/>
    </aura:if>-->
	
</aura:component>