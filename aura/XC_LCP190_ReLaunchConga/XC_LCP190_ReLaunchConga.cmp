<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,lightning:actionOverride,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,force:hasSObjectName"
    access="global" controller="XC_LCC190_ReLaunchConga">
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="documentList" type="List" />
    <aura:attribute name="selectedValue" type="String" />
    <aura:attribute name="document" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="spinnerControl" type="Boolean" default="false" />

    <aura:html tag="style">
        .cuf-content {
        padding: 0 0rem !important;
        }
        .slds-p-around--medium {
        padding: 0rem !important;
        }
        .slds-modal__content{
        overflow: visible !important;
        overflow-y:visible !important;
        height:unset !important;
        max-height:unset !important;
        }
    </aura:html>

    <div class="modal-header slds-modal__header slds-size_1-of-1">
        <span class="slds-avatar slds-avatar--large" align="left">
            <img src="{!$Resource.XC_SR_CongaIcon}" width="40" height="40" align="left" class="artiststhumbnail" />
        </span>

        <h4 class="title slds-text-heading--medium">
            {!$Label.c.XC_CL_ReCreateDocumentHeader}</h4>

    </div>

    <!-- MODAL BODY / INPUT FORM -->
    <div class="slds-modal__content slds-p-around--x- slds-p-horizontal_xx-large slds-p-vertical_large large slds-p-horizontal_x-small slds-size_1-of-1 slds-is-relative"
        aura:id="modalbody" id="modalbody">
        <lightning:combobox name="Document" label="{!$Label.c.XC_CL_ReCreateDocumentDocumentList}"
            placeholder="{!$Label.c.XC_CL_ReCreateDocumentPlHolder}" options="{!v.documentList}" value="None"
            onchange="{!c.saveSelectValue}" composed="true">
        </lightning:combobox>
    </div>
    <div class="modal-footer slds-modal__footer slds-size_1-of-1">
        <div class="forceChangeRecordTypeFooter">
            <lightning:button variant="brand" label="{!$Label.c.XC_CL_ReCreateDocumentButton}"
                title="{!$Label.c.XC_CL_ReCreateDocumentButton}" onclick="{!c.callConga}" />
        </div>
    </div>
</aura:component>