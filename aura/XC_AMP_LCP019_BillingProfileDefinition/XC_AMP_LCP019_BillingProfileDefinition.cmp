<aura:component extends="c:XC_AMP_LCP001_AbstractAMPComponent"
    controller="XC_AMP_LCC019_BillingProfileDefinition"
    implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,force:hasRecordId,force:hasSObjectName,lightning:availableForFlowScreens,lightning:isUrlAddressable,lightning:hasPageReference,force:lightningQuickActionWithoutHeader" access="global">

    <aura:attribute name="objectType" type="String" />
    <aura:attribute name="recordTypeId" type="String" />
    <aura:attribute name="fieldsList" type="List" />
    <aura:attribute name="contactExtraFields" type="List" />
    <aura:attribute name="documentExtraFields" type="List" />
    <aura:attribute name="readOnly" type="Boolean" default="false" />
    <aura:attribute name="spinnerControl" type="Boolean" default="true" />
    
    
    <!-- ATTRIBUTES POPULATED FROM PARENT CMP -->
    <aura:attribute name="opportunityId" type="String" />

    <aura:attribute name="contactList" type="List" />
    <aura:attribute name="addressList" type="List" />
    <aura:attribute name="cupsList" type="List" />
    <aura:attribute name="contractOpts" type="List" />

    <aura:attribute name="recordTypeName" type="String" />
    <aura:attribute name="paymentMethodCatOpts" type="List" />
    <aura:attribute name="paymentMethodCategoryVal" type="String" />
    <aura:attribute name="paymentType" type="String" default="" />
    <aura:attribute name="payment" type="List" />
    <aura:attribute name="valueMap" type="Map" default="{}"/>
    <aura:attribute name="documentMap" type="Map" default="{}"/>
    <aura:attribute name="sohoDocument" type="Object" />
    <aura:attribute name="invoiceDeliveryPreferencesPick" type="List" />
    <aura:attribute name="invoiceDelValue" type="String"/>
    <aura:attribute name="doxeeLanguages" type="List" />
    <aura:attribute name="showMultipicklistLE" type="Boolean" default="false"/>
    <aura:attribute name="legalEnt" type="String" default="" />
    <aura:attribute name="getContractBy" type="String" />
    <aura:attribute name="showCreditCard" type="boolean" default="false" />
    <aura:attribute name="showDirectDebt" type="boolean" default="false" />
    <aura:attribute name="showCommodity" type="boolean" default="false" />
    <aura:attribute name="showCUPS" type="Boolean" default="false" />
    <aura:attribute name="mandateType" type="String" default="" />
    <aura:attribute name="mandateOpts" type="List" />
    <aura:attribute name="accountRecordId" type="String"/>
    <aura:attribute name="selectedPOS" type="String" />
    <aura:attribute name="choosenContractStatus" type="String" />
    <aura:attribute name="choosenContractType" type="String" />

    <aura:attribute name="disabledSubmit" type="Boolean" default="true" />
    <aura:attribute name="showSpinner" type="Boolean" default="false" />

    <aura:attribute name="showExtFinancing" type="Boolean" default="false" />
    <aura:attribute name="showOtherExtFinancing" type="Boolean" default="false"/>
    <aura:attribute name="institutePickVal" type="String"/>
    <aura:attribute name="otherInsituteVal" type="String"/>

    <aura:attribute name="commodityContractMap" type="Object" />
    <aura:attribute name="choosenContractCup" type="String" />
    <aura:attribute name="contractBatch" type="String" />
    <aura:attribute name="commodityBillingCycleFrequency" type="String" />
    <aura:attribute name="commodityAccountId" type="String" />

    <aura:attribute name="paymentMethodTypeSelected" type="boolean" default="false" />
    <aura:attribute name="showCreateSection" type="boolean" default="false" />
    <aura:attribute name="billingProfilesMap" type="Map" default="{}"/>
    <aura:attribute name="availableBillProfiles" type="List" />

    <aura:attribute name="billingProfiles" type="List" />
    <aura:attribute name="credit" type="List" />
    <aura:attribute name="external" type="List" />
    <aura:attribute name="direct" type="List" />
    <aura:attribute name="bank" type="List" />
    <aura:attribute name="commodity" type="List" />

    <aura:handler name="init" value="{!this}" action="{!c.init}" />

    <lightning:navigation aura:id="navService" />
    <lightning:workspaceAPI aura:id="workspace" />
    <lightning:notificationsLibrary aura:id="notifLib" />

	
    <aura:if isTrue="{!v.spinnerControl}">
        <div class="slds-is-relative slds-p-around_medium">
          <lightning:spinner aura:id="mySpinner" size="large" variant="brand" style="background-color: rgba(0, 0, 0, 0)" />
        </div>
    </aura:if>

    <div class="slds-p-around_x-small">
        <c:XC_AMP_LCP005_SectionHeaderIcon text="{!$Label.c.XC_CL_ZuoraPayment}" iconName="custom:custom41" />

        <div class="slds-align_absolute-center">
            <aura:if isTrue="{!v.showSpinner }">
                <lightning:spinner aura:id="mySpinner" variant="brand" size="large" />
            </aura:if>
        </div>
        
   <lightning:card variant="narrow" class="slds-card_boundary">
            
            <lightning:messages aura:id="errorMessages" />
            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="6" padding="around_small">
                <lightning:recordEditForm objectApiName="NE__Billing_Profile__c">    
                    <lightning:inputField aura:id="accountId" fieldName="NE__Account__c" 
                                            value="{!v.valueMap.accountId}" disabled="true" variant="label-inline" required="false" />
                </lightning:recordEditForm>
                </lightning:layoutItem>
                <lightning:layoutItem size="6" padding="around_small">
                    <lightning:combobox name="contact" label="{!$Label.c.XC_CL_Contact}"
                            value="{!v.valueMap.contactId}" options="{!v.contactList}" disabled="true" variant="label-inline" />
                </lightning:layoutItem>
                <lightning:layoutItem size="6" padding="around_small">
                    <lightning:combobox name="address1" label="{!$Label.c.XC_CL_Billing_Address}"
                            value="{!v.valueMap.billingAddress }" options="{!v.addressList}" disabled="true"  variant="label-inline" />
                </lightning:layoutItem>
                <lightning:layoutItem size="6" padding="around_small">
                    <lightning:combobox name="address2" label="{!$Label.c.XC_CL_SoldAddress}"
                            value="{!v.valueMap.soldAddress}" options="{!v.addressList}" disabled="true" variant="label-inline"/>
                </lightning:layoutItem>
                <lightning:layoutItem size="6" padding="around_small">
                <lightning:recordEditForm objectApiName="NE__Billing_Profile__c">
                    <lightning:inputField aura:id="legalEntity" fieldName="XC_LegalEntity__c" 
                                            value="{!v.valueMap.legalEntity}" disabled="true" variant="label-inline" />
                    </lightning:recordEditForm>
                </lightning:layoutItem>
            </lightning:layout>

            <aura:if isTrue="{!v.valueMap.showDocumentExtraFields}">
                <div class="slds-var-p-around_small">
                    <lightning:card class="slds-card_boundary" title="{!$Label.c.XC_CL_LCP116_SohoDocSectHeader}" iconName="standard:channel_program_members">
                        <lightning:recordEditForm recordId="{!v.accountRecordId}" objectApiName="Account" density="compact">
                            <!--onsuccess="{!c.onSuccessSave}"-->
                            <lightning:messages aura:id="errorMessages" />
                            <lightning:layout multipleRows="true">
                                <aura:iteration items="{!v.documentExtraFields}" var="field">
                                    <lightning:layoutItem size="6" smallDeviceSize="12" mediumDeviceSize="12" largeDeviceSize="6">
                                        <div class="slds-p-around_xx-small">
                                            <lightning:inputField aura:id="field" readonly="{!v.readOnly}" disabled="true"
                                                required="{!field.isRequired}" fieldName="{!field.fieldName}"/>
                                        </div>
                                    </lightning:layoutItem>
                                </aura:iteration>
                            </lightning:layout>
                        </lightning:recordEditForm>
                    </lightning:card>
                </div>
            </aura:if>
            <br></br>
            <br></br>

            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="6" padding="around_small">
                        <lightning:combobox aura:id="combopaymentcategory" name="paymentCat"
                        label="{!$Label.c.XC_CL_MOP_Category}" value="{!v.paymentMethodCategoryVal}"
                        options="{!v.paymentMethodCatOpts}" disabled="true" variant="label-inline" />
                </lightning:layoutItem>
    
                <lightning:layoutItem size="6" padding="around_small">
                    <lightning:combobox aura:id="comboboxpayment" name="payment" label="{!$Label.c.XC_CL_PaymentMethodType}"
                        value="{!v.valueMap.payment}" required="true" options="{!v.payment}"
                        onchange="{!c.checkPayment }" variant="label-inline" />
                </lightning:layoutItem>
                <br></br>
            </lightning:layout>
            <br></br>
            <br></br>
            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="6" padding="around_small">
                            <lightning:combobox aura:id="existingBillingProfilesLI" name="existingBillingProfilesLI" label="{!$Label.c.XC_CL_BillingProfileLineItem}"
                                        value="{!v.valueMap.billingProfileLineItem}" options="{!v.billingProfiles}" onchange="{!c.selectBillingProfileLineItem}"
                                        variant="label-inline"/>
                    </lightning:layoutItem>
            </lightning:layout>
            <br></br>
            <lightning:layout multipleRows="true">
                    <lightning:layoutItem size="6" padding="around_small">
                    <lightning:button aura:id="createNewButton" variant="neutral" label="{!$Label.c.XC_CL_CreateNewBillinProfile}" title="Create New Billing Profile" disabled="{!(!v.paymentMethodTypeSelected)}"
                        onclick="{!c.displayCreateSection }" />
                </lightning:layoutItem>
            </lightning:layout>
            <br></br>
            <br></br>
            <aura:if isTrue="{!v.showCreateSection}">
                <lightning:layout multipleRows="true">
                    <aura:if isTrue="{!v.showDirectDebt}">
                     <!-- Bank Account Information: -->
                        <lightning:layoutItem size="6" padding="around_small">
                             <lightning:input aura:id="accountIban" name="accountIban"
                                 label="{!$Label.c.XC_CL_Account_Number}" value="{!v.valueMap.iban}"
                                 onchange="{!c.checkValue}" required="true" variant="label-inline"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="6" padding="around_small">
                             <lightning:input aura:id="bic" name="bic" label="BIC" value="{!v.valueMap.bic}"
                                 onchange="{!c.checkValue}" required="false" variant="label-inline"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="6" padding="around_small">
                             <lightning:combobox aura:id="mandateT" name="mandateT" label="{!$Label.c.XC_CL_MandateType}"
                                 options="{!v.mandateOpts}" value="{!v.mandateType}" required="true" variant="label-inline" onchange="{!c.checkValue}"/>
                        </lightning:layoutItem>
                    </aura:if>
                </lightning:layout>
                <br></br>
                <aura:if isTrue="{!v.showExtFinancing}">
                    <div class="slds-var-p-around_small">
                        <lightning:recordEditForm objectApiName="NE__Billing_Profile__c">
                            <lightning:messages /> 
                            <lightning:card class="slds-card_boundary" title="{!$Label.c.XC_CL_LCP116_FinInstitutePanelHeader}"
                                iconName="utility:money">
                                <lightning:inputField aura:id="legalBPFinancing" fieldName="XC_LegalEntity__c"
                                value="{!v.valueMap.legalEntity}" disabled="{!v.disableLEPick}" class="slds-hide" onchange="{!c.checkExternalFinancing}"/>
                                <lightning:inputField aura:id="finInstitute" value="{!v.institutePickVal}" fieldName="XC_FinancialInstitute__c"
                                    required="true" onchange="{!c.checkExternalFinancing}"/>
                                <aura:if isTrue="{!v.showOtherExtFinancing}">
                                    <lightning:inputField aura:id="otherFinInstitute"
                                        fieldName="XC_OtherFinancialInstitute__c" value="{!v.otherInsituteVal}" required="true" onchange="{!c.checkExternalFinancing}"/>
                                </aura:if>
                            </lightning:card>
                        </lightning:recordEditForm>
                    </div>
                    <br></br>
                </aura:if>

                <aura:if isTrue="{! v.showCommodity}">
                    <lightning:layout multipleRows="true">
                        <aura:if isTrue="{!v.getContractBy == 'POS'}">
                            <lightning:layoutItem size="6" smallDeviceSize="12" mediumDeviceSize="12" largeDeviceSize="6">    
                                <lightning:combobox aura:id="commodityDataByPOS"
                                    label="POD" name="commodityDataByPOS"
                                    required="true" options="{!v.cupsList}" value="{!v.selectedPOS}" variant="label-inline" /> <!-- onchange="{!c.onChooseCommodityPOS}"-->
                            </lightning:layoutItem>
                            <lightning:layoutItem size="6" smallDeviceSize="12" mediumDeviceSize="12" largeDeviceSize="6">
                                <lightning:input aura:id="contractId" name="contractId"
                                    label="{!$Label.c.XC_CL_Commodity_ContractID}" value="{!v.valueMap.contractId}"
                                    required="true" disabled="true" variant="label-inline" /> <!-- onchange="{!c.checkValue }" -->
                            </lightning:layoutItem>
                        <aura:set attribute="else">
                            <lightning:layoutItem size="6" smallDeviceSize="12" mediumDeviceSize="12" largeDeviceSize="6">
                                <lightning:combobox aura:id="commodityContractsB2C"
                                    label="{!$Label.c.XC_CL_LCP116_CommodityContractPick}" name="commodityContractsB2C"
                                    required="true" options="{!v.contractOpts}"  variant="label-inline" onchange="{!c.onChooseCommodityContract}"/> <!--  -->
                                </lightning:layoutItem>
                        </aura:set>
                        </aura:if>
                    </lightning:layout>
                </aura:if>
                <br></br>
                <div aura:id="accountInfoDiv" id="accountInfoDiv">
                    <lightning:layout multipleRows="true">
                        <lightning:layoutItem size="6" padding="around_small">
                                <lightning:combobox aura:id="comboboxdoxee" name="doxeelanguge" label="{!$Label.c.XC_PreferredLanguage}"
                                            value="{!v.valueMap.doxeeLanguage}" options="{!v.doxeeLanguages }" onchange="{!c.checkValue}"
                                            required="true"  variant="label-inline"/>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="6" padding="around_small">
                                <lightning:combobox aura:id="invoiceDeliveryPreferencesPick" name="invoiceDeliveryPreferencesPick"
                                        label="{!$Label.c.XC_InvoiceDeliveryPreferences}" onchange="{!c.checkValue}"
                                        value="{!v.invoiceDelValue}" required="true"
                                        options="{!v.invoiceDeliveryPreferencesPick }" variant="label-inline" /> <!-- onchange="{!c.checkContact }"-->
                        </lightning:layoutItem>
                    </lightning:layout>
                </div>
            </aura:if>
           <br></br>

        </lightning:card>
    </div>
    <div>
            
    </div>

</aura:component>