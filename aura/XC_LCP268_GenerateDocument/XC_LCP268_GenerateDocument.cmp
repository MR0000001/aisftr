<aura:component controller="XC_LCC268_GenerateDocument"
                implements="lightning:isUrlAddressable,force:appHostable,force:hasRecordId,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride"
                access="global">

            <aura:html tag="style">
                .slds-modal {
                visibility: hidden;
                display: none;
                }
               <!-- .slds-backdrop{
                display: none;
                
                }   -->     
            </aura:html> 
    <!-- ATTRIBUTES --> 
    <aura:attribute name="spinnerControl" type="Boolean" default="false" />
    <!-- HANDLER -->
    <aura:handler name="init" value="{!this}" action="{!c.init}"/>
    <!-- BODY -->
    <aura:if isTrue="{!v.spinnerControl}">
        <lightning:spinner aura:id="mySpinner" alternativeText="Loading"/>
    </aura:if>           

</aura:component>