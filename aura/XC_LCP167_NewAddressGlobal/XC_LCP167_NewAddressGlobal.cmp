<!--
* @author Simone Trenta - strenta@deloitte.it
* @date Creation 22/10/2019
* @date Modification 
* @description XC_LCP167_NewAddressGlobal – Component for create new Address
-->
<aura:component controller="XC_LCC011_NewAddress" implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId,flexipage:availableForRecordHome,force:lightningQuickActionWithoutHeader,lightning:actionOverride,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,lightning:isUrlAddressable,lightning:actionOverride">
    
    <aura:attribute name="recordId" type="String" />  
    <aura:attribute name="source" type="String" default="" />
    <aura:attribute name="IdFromMobile" type="String" />
    <aura:attribute name="addressToUpdate" type="Boolean" default="false" /> 
    <aura:attribute name="showButtonSection" type="Boolean" default="true" /> 
    <aura:attribute name="mandatoryFields" type="List" default="['country', 'province', 'city', 'streetTypeText', 'streetNumber', 'address', 'postalCode']"/>
    <aura:attribute name="timer" type="Object" default="null" />

    <aura:attribute name="address" type="Map" 
        default=" { 
            country : '',                                          
            streetType : '', 
            address : '', 
            streetNumber : '', 
            door : '',
            postalCode : '', 
            stair : '', 
            floor : '',
            city : '',
            province : '',
            category : '',
            municipality : '',    
            provinceCode : '',
            cityCode : '',
            streetTypeText : '', 
            gas : '',
            electric : '',
            lead: '',
            account: '',

            validate : false, 
            validatedCups : false, 
            isAccountPartner : 'false',
            
            clarifType : '',
            clarifValue : ''
        }"/>



    <lightning:workspaceAPI aura:id="workspace" />
    <aura:registerEvent name="XC_LCE013_SetAddressObject" type="c:XC_LCE013_SetAddressObject"/>
    <aura:registerEvent name="XC_LCE004_closeNewAddress" type="c:XC_LCE004_closeNewAddress"/>
    <aura:registerEvent name="XC_LCE018_ChangeAddressCountry" type="c:XC_LCE018_ChangeAddressCountry"/>
    <aura:handler name="init" value="{! this }" action="{! c.doInit }"/> 
    
    <ltng:require styles="{!$Resource.XC_STR004_CompWidth100}" /> 
    <lightning:notificationsLibrary aura:id="notifLib"/>
   
    <aura:if isTrue="{!and(and((v.source!='002'), (v.source!='003')), (v.source!='013'))}"> 
        <lightning:card variant="Narrow" title="{!$Label.c.XC_CL_Address}" iconName="standard:location">
            <aura:set attribute="footer">
                <br></br>
            </aura:set>
        </lightning:card>
    </aura:if>

    <lightning:recordEditForm objectApiName="XC_Address__c"> 

        <lightning:messages />

        <lightning:layout multipleRows="true">
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" padding="around-small">
                <lightning:inputField aura:id="country" fieldName="XC_AddressCountry__c" required="true" onchange="{!c.setPickCountry}" value="{!v.address.country}"/>     
                <lightning:inputField aura:id="city" fieldName="XC_City__c" value="{!v.address.city}" required="true" onchange="{!c.sendAddressToMain}" onclick="" /> 
                <lightning:inputField aura:id="streetTypeText" fieldName="XC_StreetTypeText__c" value="{!v.address.streetTypeText}" required="true" onchange="{!c.sendAddressToMain}" onclick="" />
                <lightning:inputField aura:id="streetNumber" fieldName="XC_StreetNumber__c" value="{!v.address.streetNumber}" required="true" onchange="{!c.sendAddressToMain}" onclick="" />
                <lightning:inputField aura:id="floor" fieldName="XC_Floor__c" value="{!v.address.floor}" onchange="{!c.sendAddressToMain}" onclick="" />      
                <lightning:inputField aura:id="door" fieldName="XC_Door__c" value="{!v.address.door}" onchange="{!c.sendAddressToMain}" onclick="" />        
                <lightning:inputField aura:id="stair" fieldName="XC_Stair__c" value="{!v.address.stair}" onchange="{!c.sendAddressToMain}" onclick="" />
            </lightning:layoutItem>
            
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" padding="around-small">      
                <lightning:inputField aura:id="category" fieldName="XC_Category__c" value="{!v.address.category}" onchange="{!c.sendAddressToMain}" onclick="" />                 
                <lightning:inputField aura:id="province" fieldName="XC_AddressProvince__c" value="{!v.address.province}" required="true" onchange="{!c.sendAddressToMain}" onclick="" /> 
                <lightning:inputField aura:id="address"  fieldName="XC_Address__c" value="{!v.address.address}" required="true" onchange="{!c.sendAddressToMain}" onclick="" />
                <lightning:inputField aura:id="postalCode" fieldName="XC_PostalCode__c" value="{!v.address.postalCode}" required="true" onchange="{!c.sendAddressToMain}" onclick="" />
                <lightning:inputField aura:id="gasCUP" fieldName="XC_GasCUPS__c" value="{!v.address.gas}" onchange="{!c.sendAddressToMain}" onclick=""/>
                <lightning:inputField aura:id="electricCUP" fieldName="XC_ElectricCUPS__c" value="{!v.address.electric}" onchange="{!c.sendAddressToMain}" onclick=""/>  
            </lightning:layoutItem> 	      
        </lightning:layout> 
    </lightning:recordEditForm>

    <lightning:layout horizontalAlign="end" >
        <lightning:layoutItem padding="around-small">
        
            <lightning:buttonGroup>
                
                <aura:if isTrue="{!and((v.source!='002'), (v.source!='003'))}">
                   	<lightning:button aura:id="saveButton" disabled="{!!v.address.validate}" variant="brand" label="{!$Label.c.XC_CL_SaveButton}" title="Brand action" onclick="{!c.saveAddress}" />
                    
                    <aura:if isTrue="{!(v.source!='013')}">
                        <lightning:button label="{!$Label.c.XC_CL_Cancel}" title="Brand action" onclick="{! c.cancel }" />
                    </aura:if>
                </aura:if> 
                    
                <aura:if isTrue="{!not(v.showButtonSection)}">
                    <lightning:button aura:id="editButton" label="{!$Label.c.XC_CL_EditButton}" onclick="{!c.onModify}"/>
                </aura:if>

            </lightning:buttonGroup>

        </lightning:layoutItem>
    </lightning:layout>

</aura:component>