* @date Modification dd/mm/yyyy
* @description XC_LCP071_NewCaseFromAsset – Describe the functionality
-->
<aura:component controller="XC_LCC199_CreateContractFromOpportunity"
                implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader,lightning:actionOverride,force:hasRecordId">
	<aura:attribute name="recordId" type="String" />
    <aura:attribute name="assetName" type="String"/>
    <aura:attribute name="contactId" type="String"/>
    <aura:attribute name="accountId" type="String"/>
    <aura:attribute name="recordTypeCase" type="String"/>
    <aura:attribute name="originUser" type="String"/>
    <aura:attribute name="spinnerControl" type="Boolean" default="false" />
    <aura:handler name="init" value="{! this }" action="{! c.doInit }"/>
    
    <lightning:notificationsLibrary aura:id="notifLib"/>

    <aura:if isTrue="{!v.spinnerControl}" >
        <div aura:id="masterSpinner"  class="slds-is-relative">
            <lightning:spinner aura:id="mySpinner"/>
        </div>
    </aura:if>

</aura:component>