<aura:component controller="XC_LCC205_SendSAP"  implements="flexipage:availableForRecordHome" access="global">
    
    <aura:attribute name="lineOk" type="Boolean" default="false"/>
    <aura:attribute name="forSearch" type="Boolean" default="false"/>
    <aura:attribute name="purchaseOrderLineId" type="String" />
    <aura:attribute name="recordId" type="String" />  
    <aura:attribute name="errorMessage" type="String" default=""/> 
    <aura:attribute name="errorMessage2" type="String" default=""/> 
    <aura:attribute name="numberOfSerialToShow" type="Integer" default="1"/>
    
    <aura:attribute name="purchaseOOptions" type="List"  />
    <aura:attribute name="divisionOptions" type="List"  />
    <aura:attribute name="POLList" type="List" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:handler event="c:XC_LCE207_RefreshSAPItem" action="{!c.doInit}" />
    <br></br>
     <b>&nbsp; {!v.errorMessage} </b>
     <b>&nbsp; {!v.errorMessage2} </b>

    <aura:if isTrue="{!v.lineOk}">


        <aura:iteration items="{!v.POLList}" var="pol" >
             <div class="slds-box">
           <c:XC_LCP207_SingleSAPItem polId="{!pol.polId}" Name="{!pol.Name}" purchaseOrderId="{!v.recordId}"
                                        readOnly="{!pol.readOnly}"
                                        category="{!pol.category}"
                                        division="{!pol.division}"
                                        purchaseOrganization="{!pol.purchaseOrganization}"
                                        definitionOfDivision="{!pol.definitionOfDivision}"
                                        definitionOfPurchaseOrganization="{!pol.definitionOfPurchaseOrganization}"
                                        divisionToDefinition="{!pol.divisionToDefinition}"
                                        purchaseOrganizationToDefinition="{!pol.purchaseOrganizationToDefinition}"
                                        divisionMap="{!pol.divisionMap}"
                                        purchaseOrganizationMap="{!pol.purchaseOrganizationMap}"
                                        applicantUnitDefault="{!pol.applicantUnitDefault}"
                                        applicantUnitMap="{!pol.applicantUnitMap}"
                                        product="{!pol.product}"
                                        quantity="{!pol.quantity}"
                                        priceBookEntryName="{!pol.priceBookEntryName}"
                                        ></c:XC_LCP207_SingleSAPItem>
            </div>
        </aura:iteration><br></br>
    
   
      
    </aura:if>
</aura:component>