<aura:component controller="TA_LCC250_SelectAccount"
    implements="force:appHostable,flexipage:availableForAllPageTypes,force:lightningQuickAction,force:hasRecordId,forceCommunity:availableForAllPageTypes"
    access="global">

    <aura:attribute access="public" name="showToastMessage" type="Boolean" />
    <aura:attribute access="public" name="isError" type="Boolean" />
    <aura:attribute access="public" name="toastMessage" type="String" />
    <aura:attribute access="public" name="showSelectAccountModal" type="Boolean" default="false"/>
    <aura:attribute access="public" name="showSelectAddressModal" type="Boolean" default="false"/>
    <aura:attribute access="public" name="searchParam" type="String" default=""/>
    <aura:attribute access="public" name="disableSearch" type="Boolean" default="true"/>
    <aura:attribute access="public" name="disableConfirmAccount" type="Boolean" default="true"/>
    <aura:attribute access="public" name="disableConfirmAddress" type="Boolean" default="true"/>
    <aura:attribute access="public" name="searchResultList" type="List"/>
    <aura:attribute access="public" name="selectedAccountId" type="String"/>
    <aura:attribute access="public" name="selectedAddressId" type="String"/>
    <aura:attribute access="public" name="communityBaseUrl" type="String"/>
    <aura:attribute access="public" name="noAccountFound" type="Boolean" default="true"/>
    <aura:attribute access="public" name="productCategoryValues" type="List"/>
    <aura:attribute access="public" name="filteredProductCategoryValues" type="List"/>
    <aura:attribute access="public" name="selectedProductCategory" type="String"/>
    <aura:attribute access="public" name="selectedAccountRecordTypeDeveloperName" type="String"/>
    <aura:attribute access="public" name="productCategoryDisabled" type="Boolean" default="true"/>
    <aura:attribute access="public" name="showProductCategory" type="Boolean" default="false"/>
    <aura:attribute access="public" name="createAddressLabel" type="String" default="{!$Label.c.TA_CreateNewAddress}"/>
    <aura:attribute access="public" name="showAddressSection" type="Boolean" default="false"/>
    <aura:attribute access="public" name="addressMap" type="Map" />
    <aura:attribute access="public" name="calledFromExternalCmp" type="Boolean" default="false" />
    <aura:attribute access="public" name="recordTypesMap" type="List"/>
    <aura:attribute access="public" name="handleResponseLayout" type="Object"/>
    <aura:attribute access="public" name="recordTypeId" type="String"/>

    <aura:attribute access="private" name="accountSelected" type="Object"/>

    <ltng:require styles="{!join(',',
                        $Resource.TA_CSS + '/TA_CSS/slds-override.css',
                        $Resource.TA_CSS + '/TA_CSS/ta-classes-mobile.css',
                        $Resource.TA_CSS + '/TA_CSS/ta-classes-tablet.css')}" />

    <aura:handler name="init" value="{!this}" action="{!c.handleInitialize}" />
    <aura:handler event="c:XC_LCE013_SetAddressObject" name="XC_LCE013_SetAddressObject" action="{!c.handleAddressEvent}" />

    <aura:registerEvent name="toggleSpinnerEvent" type="c:TA_LCE213_StartSpinnerEvt" />
    <aura:registerEvent name="closeModal" type="c:TA_LCE248_GenericEvent" />

    <c:TA_LCP236_ToastMessage showToastMessage="{!v.showToastMessage}" isError="{!v.isError}" toastMessage="{!v.toastMessage}" />

    <!-- <div class="ta-modal-bg">
        <aura:if isTrue="{!v.showSelectAccountModal}">
            <lightning:layout multipleRows="true" class="ta-modal-container ta-animation-pop-in">
                <lightning:layoutItem size="12" class="ta-modal-header">
                    <lightning:layout multipleRows="true">
                        <lightning:layoutItem size="11" class="ta-modal-header-title slds-text-align_center">
                            {!$Label.c.TA_SelectAccount}
                        </lightning:layoutItem>
                        <lightning:layoutItem size="1" class="ta-modal-header-button">
                            <img src="{!$Resource.TA_Icons + '/xc-icons/close-pink.svg'}" onclick="{!c.handleCloseModal}"/>
                        </lightning:layoutItem>
                    </lightning:layout>
                </lightning:layoutItem>
                <lightning:layoutItem size="12" class="ta-modal-body">
