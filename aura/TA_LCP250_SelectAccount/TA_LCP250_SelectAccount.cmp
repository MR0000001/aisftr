                                                    <p class="ta-color-purple ta-font-weight-800 ta-width"> {!account.name} </p>
                                                </lightning:layoutItem>
                                                <aura:if isTrue="{!not(empty(account.fiscalCode))}">
                                                    <lightning:layoutItem size="12" class="slds-text-align_left">
                                                        <p class="ta-color-purple ta-font-weight-300"> {!$Label.c.TA_SelectAccountFiscalCode}: </p>
                                                        <p class="ta-color-purple ta-font-weight-800"> {!account.fiscalCode} </p>
                                                    </lightning:layoutItem>
                                                </aura:if>
                                                <aura:if isTrue="{!not(empty(account.phone))}">
                                                    <lightning:layoutItem size="12" class="slds-text-align_left">
                                                        <p class="ta-color-purple ta-font-weight-300"> {!$Label.c.TA_SelectAccountPhone}: </p>
                                                        <p class="ta-color-purple ta-font-weight-800"> {!account.phone} </p>
                                                    </lightning:layoutItem>
                                                </aura:if>
                                                <aura:if isTrue="{!not(empty(account.email))}">
                                                    <lightning:layoutItem size="12" class="slds-text-align_left">
                                                        <p class="ta-color-purple ta-font-weight-300"> {!$Label.c.TA_SelectAccountEmail}: </p>
                                                        <p class="ta-color-purple ta-font-weight-800"> {!account.email} </p>
                                                    </lightning:layoutItem>
                                                </aura:if>
                                            </lightning:layout>  
                                        </div>
                                    </aura:iteration>
                                </lightning:layoutItem>
                            </aura:set>
                        </aura:if>

                        <aura:if isTrue="{!and(v.showProductCategory, not(v.calledFromExternalCmp))}">
                            <lightning:layoutItem size="12" class="slds-text-align_center slds-m-bottom_x-small">
                                <p class="ta-color-purple slds-m-bottom_x-small"> {!$Label.c.TA_SearchAccountSelectProductType} </p>
                                <lightning:select class="ta-category-picklist"
                                    name="productCategoryList"
                                    value="{!v.selectedProductCategory}"
                                    disabled="{!v.productCategoryDisabled}">
                                    <aura:iteration items="{!v.filteredProductCategoryValues}" var="product">
                                        <option value="{!product}">{!product}</option>
                                    </aura:iteration>
                                </lightning:select>
                            </lightning:layoutItem>
                        </aura:if>
                    </lightning:layout>
                </lightning:layoutItem>

                <lightning:layoutItem size="12" class="ta-modal-footer-one-button">
                    <lightning:button class="ta-button-primary-modal"
                                    label="{!$Label.c.TA_SelectOrCreateAddress}"
                                    name="SelectOrCreateAddress"
                                    onclick="{!c.handleShowAddressModal}"
                                    disabled="{!v.disableConfirmAccount}"/>
                </lightning:layoutItem>
            </lightning:layout>
            </aura:if>

            <aura:if isTrue="{!v.showSelectAddressModal}">
            <lightning:layout multipleRows="true" class="ta-modal-container ta-animation-pop-in">
                <aura:if isTrue="{!and(and(v.accountSelected != null, not(empty(v.accountSelected.addressList))), not(v.showAddressSection))}">
                    <lightning:layoutItem size="12" class="ta-modal-header">
                        <lightning:layout multipleRows="true">
                            <lightning:layoutItem size="1" class="ta-modal-header-button">
                                <img src="{!$Resource.TA_Icons + '/xc-icons/back.svg'}" onclick="{!c.handleBackModal}"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem size="11" class="ta-modal-header-title slds-text-align_center">
                                {!$Label.c.TA_SelectAddress}
                            </lightning:layoutItem>
                        </lightning:layout>
                    </lightning:layoutItem>
                    <lightning:layoutItem size="12" class="ta-modal-body">
                        <lightning:layout multipleRows="true">
                            <lightning:layoutItem size="12" class="ta-height-custom slds-scrollable">
                                <aura:iteration items="{!v.accountSelected.addressList}" var="address">
                                    <div id="{!address.addressId}" onclick="{!c.handleSelectAddress}" class="{!if(address.selected, 'ta-account-card-selected', 'ta-account-card')}">
                                        <lightning:layout multipleRows="true" class="ta-height-100 slds-p-around_medium">
                                            <lightning:layoutItem size="6" class="slds-text-align_left slds-m-bottom_x-small">
                                                <p class="ta-color-purple ta-font-weight-800 ta-width"> {!address.streetType + ' ' + address.streetName + ' ' + address.streetNumber + ', ' + address.city + ', ' + address.postalCode} </p>
                                            </lightning:layoutItem>
                                        </lightning:layout>  
                                    </div>
                                </aura:iteration>
                            </lightning:layoutItem>
                        </lightning:layout>
                    </lightning:layoutItem>
                    <lightning:layoutItem size="12" class="ta-modal-footer-two-button">
                        <lightning:layout multipleRows="true">
                            <lightning:layoutItem size="12" class="slds-m-bottom_small">
                                <lightning:button class="ta-button-secondary-modal"
                                                label="{!v.createAddressLabel}"
                                                name="toggleNewAddressSection"
                                                onclick="{!c.handleToggleAddressSection}"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem size="12">
