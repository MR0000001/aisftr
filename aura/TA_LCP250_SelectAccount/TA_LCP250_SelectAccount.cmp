                                                label="{!$Label.c.TA_ProceedWithSale}"
                                                onclick="{!c.handleConfirmAccount}"
                                                disabled="{!v.disableConfirmAddress}"/>
                            </lightning:layoutItem>
                        </lightning:layout>
                    </lightning:layoutItem>
                    <aura:set attribute="else">
                        <lightning:layoutItem size="12" class="ta-modal-header">
                            <lightning:layout multipleRows="true">
                                <lightning:layoutItem size="1" class="ta-modal-header-button">
                                    <img src="{!$Resource.TA_Icons + '/xc-icons/back.svg'}" onclick="{!c.handleBackModal}"/>
                                </lightning:layoutItem>
                                <lightning:layoutItem size="11" class="ta-modal-header-title slds-text-align_center">
                                    {!$Label.c.TA_CreateNewAddress}
                                </lightning:layoutItem>
                            </lightning:layout>
                        </lightning:layoutItem>
                        <lightning:layoutItem size="12" class="ta-modal-body">
                            <c:XC_LCP_Address source="003" parentRecordType="{!v.selectedAccountRecordTypeDeveloperName}"/>
                        </lightning:layoutItem>
                        <aura:if isTrue="{!and(v.accountSelected != null, not(empty(v.accountSelected.addressList)))}">
                            <lightning:layoutItem size="12" class="ta-modal-footer-two-button">
