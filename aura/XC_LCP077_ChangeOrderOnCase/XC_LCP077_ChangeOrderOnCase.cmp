<!--
* @author Lorenzo Orlanducci lorenzo.orlanducci@nttdata.com 
* @date Creation 13/02/2019
* @date Modification dd/mm/yyyy
* @description component for disconnect asset on Case record page
-->
<aura:component controller="XC_LCC073_DisconnectAsset" implements="force:appHostable,flexipage:availableForAllPageTypes,lightning:isUrlAddressable,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,force:hasSObjectName,lightning:availableForFlowScreens" access="global" >
<!-- components attributes -->
<aura:attribute name="recordId" type="String" />
<aura:attribute name="assetId" type="String" />
<aura:attribute name="oldTab" type="String" />
<aura:attribute name="disabledSubmit" type="Boolean" default="true" />
<aura:attribute name="secondSpinner" type="Boolean" default="true" /> 
<aura:attribute name="isReadOnly" type="Boolean" default="false" />
<aura:attribute name="disegnComplaintPick" type="Boolean" default="false" />
<aura:attribute name="disegnPick" type="Boolean" default="false" />
<aura:attribute name="subtype" type="String" />
<aura:attribute name="purchOptionValue" type="String" />
<aura:attribute name="isOptionvalid" type="Boolean" default="false" />
<aura:attribute name="showPurchOption" type="Boolean" default="true" />
<aura:attribute name="skipOrderCreation" type="Boolean" default="false" />
<aura:attribute name="complaintOptions" type="List"  />
<aura:attribute name="contractNumber" type="String" />
<aura:attribute name="contrStartD" type="String" />
<aura:attribute name="contrEndD" type="String" />
<aura:attribute name="legalText" type="String" />
<aura:attribute name="showLegalText" type="Boolean" default="false" />
<lightning:navigation aura:id="navService"/>
<lightning:workspaceAPI aura:id="workspace" />
<lightning:notificationsLibrary aura:id="notifLib"/>

<aura:handler name="init" value="{!this}" action="{!c.doInit}" /> 

    <div class="main" >
        
    <lightning:recordEditForm objectApiName="NE__Order__c">
        <!-- the messages component is for error messages -->
        <lightning:messages />
        <aura:if isTrue="{!v.disegnPick}">  
            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
                    <lightning:inputField aura:id="type" value="ChangeOrder" fieldName="NE__Type__c" disabled="true" />
                </lightning:layoutItem>
                <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
                        <lightning:inputField aura:id="subtype" value="{!v.subtype}" fieldName="XC_Subtype__c" disabled="true" onchange="{!c.checkNotBlank}" /> <!--disabled="{!v.isReadOnly}"-->
                </lightning:layoutItem>
            </lightning:layout>
        </aura:if>
    </lightning:recordEditForm>

    
    <aura:if isTrue="{!v.isOptionvalid}">
        <lightning:layout multipleRows="true">
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
            <div class="slds-form_horizontal">    
                <lightning:input name="purchOptionValue" label="{!$Label.c.XC_CL_PurchaseAmount}" value="{!v.purchOptionValue}" disabled="true" />
            </div>
            </lightning:layoutItem>
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
            <div class="slds-form_horizontal">
                
            </div>
            </lightning:layoutItem>
        </lightning:layout>
    </aura:if>

    <aura:if isTrue="{!v.showLegalText}">
        <lightning:layout multipleRows="true">
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
            <div class="slds-form_horizontal">
                <lightning:input name="contractNumber" label="{!$Label.c.XC_CL_ContractNumber}" value="{!v.contractNumber}" disabled="true" />
            </div>
            </lightning:layoutItem>
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
            <div class="slds-form_horizontal">
                <lightning:input name="contrStartD" label="{!$Label.c.XC_CL_Contract_StartDate}" value="{!v.contrStartD}" disabled="true" />
            </div>
            </lightning:layoutItem>
        </lightning:layout>
        <lightning:layout multipleRows="true">
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
            <div class="slds-form_horizontal">
                &nbsp;
                <!--<lightning:textarea name="legalText" class="tallTextArea" disabled="true" value="{!v.legalText}" label="{!$Label.c.XC_CL_LegalText}" />-->
            </div>
            </lightning:layoutItem>
            <lightning:layoutItem size="12" smallDeviceSize="6" mediumDeviceSize="6" largeDeviceSize="6" >
            <div class="slds-form_horizontal">
                <lightning:input name="contrEndD" label="{!$Label.c.XC_CL_Contract_EndDate}" value="{!v.contrEndD}" disabled="true" />
            </div>
            </lightning:layoutItem>
        </lightning:layout>
    </aura:if>
            
    <aura:if isTrue="{!v.secondSpinner}">
        <div style="position: fixed; top: 0; right: -532px; bottom: 0; left: -532px; z-index: 9998; background-color: white">  
            <lightning:spinner aura:id="mySpinner2" />
        </div>
    </aura:if>

        <div class="abbass">
        </div>
        <div class="modal-footer slds-modal__footer slds-size_1-of-1">
            <aura:if isTrue="{!v.showLegalText}">
                <lightning:button label="{!$Label.c.XC_CL_LegalTextButton}" title="CongaLegalText" onclick="{! c.callLegalText }" />
            </aura:if>
            <lightning:button  label="{!$Label.c.XC_CL_CancelButton}" title="Cancel" onclick="{!c.cancel}"/>
            <lightning:button variant="brand" label="{!$Label.c.XC_CL_ConfirmButton}" title="Submit" onclick="{! c.dis}" disabled="{!v.disabledSubmit}" />
        </div>   
</div>

   

</aura:component>