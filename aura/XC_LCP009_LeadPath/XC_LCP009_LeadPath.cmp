<aura:component implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,forceCommunity:layout,force:hasRecordId" >
    <aura:attribute name="hideUpdateButton" type="Boolean" default="true"/>
    <aura:handler name="init" value="{! this }" action="{! c.doInit }"/>

    <lightning:path aura:id="path" recordId="{!v.recordId}"
        variant="linear"
        hideUpdateButton="{!v.hideUpdateButton}"
        onselect="{!c.handleSelect}"
    />
</aura:component>