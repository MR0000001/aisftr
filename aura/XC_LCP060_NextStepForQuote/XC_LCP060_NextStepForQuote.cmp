<!--
* @author Lorenzo Orlanducci lorenzo.orlanducci@nttdata.com & Monica Cutillo monica.cutillo@nttdata.com
* @date Creation 27/11/2018
* @date Modification dd/mm/yyyy
* @description XC_LCP044_OptyCheckBeforeNextStep – Associated to a button action 'Next Step' custom, 
* checks if is bossible do effectly the Next Step for an order Opty.
-->
<aura:component controller="XC_LCC044_OptyCheckBeforeNextStep" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,force:hasSObjectName,lightning:availableForFlowScreens" access="global" >

<aura:attribute name="recordId" type="String" />
<aura:attribute name="isModal" type="Boolean" default="false" />
<aura:attribute name="isCommunity" type="Boolean" default="false" />
    
<aura:attribute name="urlNextStepB2W" type="String" />
<aura:attribute name="sitePrefix" type="String" />

<lightning:notificationsLibrary aura:id="notifLib"/>
<aura:handler name="init" value="{!this}" action="{!c.init}"/>  

   <div aura:id="masterSpinner"  class="slds-is-relative">
         <lightning:spinner aura:id="mySpinner"/>
   </div>

   <aura:if isTrue="{!v.isModal}">
      <iframe src="{!v.urlNextStepB2W}" width="100%" height="130%" frameBorder="0" scrolling="yes" allowtransparency="true"
              id="NE__Order__c.Next_Step" name="NE__Order__c.Next_Step"/>
   </aura:if>

</aura:component>