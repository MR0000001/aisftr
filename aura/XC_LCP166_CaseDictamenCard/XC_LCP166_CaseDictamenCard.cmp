<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId" controller="XC_LCC166_CaseDictamenCardController" access="global">

    <aura:attribute name = "caseRecord" type="Object"/>
    <aura:attribute name = "recordError" type="String"/>

    <aura:attribute name = "dictamenFields" type="List"/>
    <aura:attribute name = "dictamenId" type="String"/>


    <force:recordData aura:id="recordLoader"
      recordId="{!v.recordId}"
      targetFields="{!v.caseRecord}"
      targetError="{!v.recordError}"
      fields="XC_WorkOrder__c"
      recordUpdated="{!c.init}"
      layoutType="FULL"
      mode="EDIT"
    />

    <lightning:recordEditForm recordId="{!v.dictamenId}" objectApiName="XC_DictamenItem__c" density="auto">
        <lightning:card iconName="standard:work_order">
            <aura:set attribute="title">
                    <a href="{! '/' + v.dictamenId}">{!$Label.c.XC_CL_DictamenComponentTitle}</a>
            </aura:set>
            <lightning:layout multipleRows="true">
                <aura:iteration items="{!v.dictamenFields}" var="field">
                    <lightning:layoutItem size="12" smallDeviceSize="12" mediumDeviceSize="6" largeDeviceSize="6" padding="horizontal-small">
                            <lightning:inputField aura:id="field" class="{!field.fieldName}" required="{!field.isRequired}" fieldName="{!field.fieldName}"/>
                    </lightning:layoutItem>
                </aura:iteration>
            </lightning:layout>
        </lightning:card>
    </lightning:recordEditForm>




</aura:component>