<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" access="global" >
	<aura:html tag="style">
        .slds-modal__container {
            max-width: 100rem !important;
            width: 100% !important;
            padding-top: 0;
        }

        .slds-button.slds-button_icon.slds-modal__close.closeIcon.slds-button_icon-bare.slds-button_icon-inverse {
            margin-top: 80px !important;
            margin-right: 30px !important;
        }
        .modal-body.scrollable.slds-modal__content.uiModal--recordActionWrapper {
            margin-top: 100px;
        }
        .quick-actions-panel {
            overflow: hidden !important;
        }

        .runtime_platform_actionsQuickActionWrapper {
            max-height: 5000% !important;
        }
        
        .slds-p-around_medium,.slds-p-around--medium {
            max-height: 5000% !important;
            height: 5000% !important;
        }
        
    </aura:html>
    
    <div class="slds-modal__container">
        <header class="slds-modal__header">
            <h2 id="modal-heading-01" class="slds-text-heading_medium slds-text-font_monospace slds-hyphenate">AMA TARI</h2>
        </header>
        <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
            <c:amaTari recordId="{!v.recordId}"/>
        </div>
    </div>
</aura:component>