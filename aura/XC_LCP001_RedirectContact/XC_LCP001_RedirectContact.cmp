<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:actionOverride,lightning:isUrlAddressable,lightning:hasPageReference" access="global" >

    <aura:attribute name="recordTypeId" type="String"/>
    <aura:attribute name="recordId" type="String" />

    <aura:handler name="init" value="{!this}" action="{!c.init}" />

    <c:XC_LCP000_RedirectLogicNewSobject objectName="Contact" objectPrefix="003" recordId="{!v.recordId}" recordTypeId="{!v.recordTypeId}"/>

	

</aura:component>