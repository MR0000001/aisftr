<aura:component controller ="XC_LCC270_CreateReturnMaterial" implements="force:lightningQuickActionWithoutHeader,force:hasRecordId,flexipage:availableForRecordHome,flexipage:availableForAllPageTypes,force:hasRecordId,lightning:actionOverride,lightning:isUrlAddressable" access="global">
    <aura:attribute name="isOpen" type="boolean" default="true"/>
    <aura:attribute name="recordId" type="Id" />
    <aura:attribute name="spinner" type="boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="disableButton" type="String" default="false"/>
   
    <div class="slds-m-around_xx-medium">
    	

        <aura:if isTrue="{!v.isOpen}">
        	<section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
				
                
                <div class="slds-modal__container" style="width:100%;">
                
                    <!-- ###### MODAL BOX HEADER Start ######-->
                    <header class="slds-modal__header">
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Create Return Material</h2>
                    </header>
                    <!--###### MODAL BOX BODY Part Start######-->
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        
                       
                        <p><b>Do you want to create Return Material woli?</b>
                        </p>
                    <br/>
                    <lightning:recordForm
                        aura:id="myRecordForm"
                        recordId="{!v.recordId}"
                        objectApiName="WorkOrderLineItem"
                        fields="XC_Form_Type__c"
                        columns="2"
                        mode="readonly"
                        onsubmit="" />
                        <aura:if isTrue="{!v.spinner}"> 

                                <div class="slds-spinner_container">
                                    <div class="slds-spinner--brand slds-spinner slds-spinner--small" role="alert">
                                        <span class="slds-assistive-text">Loading...</span>
                                        <div class="slds-spinner__dot-a"></div>
                                        <div class="slds-spinner__dot-b"></div>
                                    </div>
                                </div>
                     </aura:if>
                        
                    </div>
                    
                    <!--###### MODAL BOX FOOTER Part Start ######-->
                    <footer class="slds-modal__footer">
                                           
                        <lightning:button variant="neutral" 
                                          label="{!$Label.c.XC_CL_Cancel}"
                                          title="Cancel"
                                          onclick="{! c.closeModel }"/>
                        <lightning:button variant="brand" 
                                          label="Confirm"
                                          title="Create"
                                          onclick="{! c.onConfirm }"
                                          disabled="{!v.disableButton}"/>
                    </footer>
                </div>
  				<div class="slds-modal__content slds-p-around--medium slds-is-relative">
                        <div class="slds-spinner_container">
                            <aura:if isTrue="{!v.spinner}"> 
                                <div class="slds-spinner_container">
                                    <div class="slds-spinner--brand slds-spinner slds-spinner--medium slds-is-relative" role="alert">
                                        <span class="slds-assistive-text">Loading...</span>
                                        <div class="slds-spinner__dot-a"></div>
                                        <div class="slds-spinner__dot-b"></div>
                                    </div>
                                </div>
                            </aura:if>
                        </div>    
                </div>   
            </section>
           <!--###### MODAL BOX Part END Here ###########-->
        </aura:if>    
    </div>
</aura:component>